$ python3 << 'PYEOF'
import os, zlib, hashlib

gitdir = "/workspace/.git"

def read_object(sha):
    path = os.path.join(gitdir, "objects", sha[:2], sha[2:])
    with open(path, "rb") as f:
        compressed = f.read()
    raw = zlib.decompress(compressed)
    # Verify integrity
    assert hashlib.sha1(raw).hexdigest() == sha, "SHA mismatch!"
    # Parse header
    null_idx = raw.index(b'\0')
    header = raw[:null_idx].decode()
    data = raw[null_idx+1:]
    return header, data

# Read blob
blob_sha = "0d20b6487c61e7d1bde93acf4a14b7a89083a16d"
header, data = read_object(blob_sha)
print(f"Blob ({blob_sha}):")
print(f"  Header: {header}")
print(f"  Content: {data}")

# Read tree
tree_sha = "e05703bf7de4d1d60f49c30872101a88ca5ed06c"
header, data = read_object(tree_sha)
print(f"\nTree ({tree_sha}):")
print(f"  Header: {header}")
# Parse tree entries
i = 0
while i < len(data):
    space = data.index(b' ', i)
    null = data.index(b'\0', space)
    mode_name = data[i:null].decode()
    entry_sha = data[null+1:null+21].hex()
    print(f"  Entry: {mode_name} -> {entry_sha}")
    i = null + 21

# Read commit
commit_sha = "d5a5bd0b8a45983042677f2c76a1e88079b0fa5d"
header, data = read_object(commit_sha)
print(f"\nCommit ({commit_sha}):")
print(f"  Header: {header}")
print(f"  Data:\n{data.decode()}")

print("\nAll objects verified successfully!")
