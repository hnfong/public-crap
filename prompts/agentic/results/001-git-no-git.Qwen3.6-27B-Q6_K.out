import os, zlib, hashlib, struct, time

workdir = "/workspace"
gitdir = os.path.join(workdir, ".git")

# Create .git directory structure
for d in ["objects", "objects/info", "refs", "refs/heads", "refs/tags"]:
    os.makedirs(os.path.join(gitdir, d), exist_ok=True)

# Write HEAD
with open(os.path.join(gitdir, "HEAD"), "w") as f:
    f.write("ref: refs/heads/main\n")

# Write a minimal config
with open(os.path.join(gitdir, "config"), "w") as f:
    f.write('[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n')

# Read .gitignore content
filepath = os.path.join(workdir, ".gitignore")
with open(filepath, "rb") as f:
    content = f.read()

# Helper: create a git object and return its hash
def make_object(data):
    """Pack data as a git object, store it, return its SHA-1 hex."""
    header = f"blob {len(data)}\0".encode()
    raw = header + data
    sha = hashlib.sha1(raw).hexdigest()
    compressed = zlib.compress(raw)
    obj_path = os.path.join(gitdir, "objects", sha[:2], sha[2:])
    with open(obj_path, "wb") as f:
        f.write(compressed)
    return sha

def make_tree_object(entries):
    """Create a tree object. entries = [(mode, name, sha1_hex), ...]"""
    raw = b""
    for mode, name, sha_hex in entries:
        raw += f"{mode} {name}\0".encode()
        raw += bytes.fromhex(sha_hex)
    header = f"tree {len(raw)}\0".encode()
    data = header + raw
    sha = hashlib.sha1(data).hexdigest()
    compressed = zlib.compress(data)
    obj_path = os.path.join(gitdir, "objects", sha[:2], sha[2:])
    with open(obj_path, "wb") as f:
        f.write(compressed)
    return sha

def make_commit_object(tree_sha, parents, message, author, timestamp):
    """Create a commit object."""
    commit_msg = f"tree {tree_sha}\n"
    for p in parents:
        commit_msg += f"parent {p}\n"
    commit_msg += f"author {author} {timestamp} +0000\n"
    commit_msg += f"committer {author} {timestamp} +0000\n\n"
    commit_msg += message + "\n"
    data = commit_msg.encode()
    header = f"commit {len(data)}\0".encode()
    raw = header + data
    sha = hashlib.sha1(raw).hexdigest()
    compressed = zlib.compress(raw)
    obj_path = os.path.join(gitdir, "objects", sha[:2], sha[2:])
    with open(obj_path, "wb") as f:
        f.write(compressed)
    return sha

# 1. Create blob object for .gitignore
blob_sha = make_object(content)
print(f"Blob SHA: {blob_sha}")

# 2. Create tree object
tree_sha = make_tree_object([("100644", ".gitignore", blob_sha)])
print(f"Tree SHA: {tree_sha}")

# 3. Create commit object with a funny joke
timestamp = int(time.time())
author = "Gitless Gopher <gopher@noshell.local>"
joke = "Why did the git repository break up with its partner? Because it had too many unresolved conflicts!"
commit_sha = make_commit_object(tree_sha, [], joke, author, timestamp)
print(f"Commit SHA: {commit_sha}")

# 4. Write the ref for main branch
with open(os.path.join(gitdir, "refs", "heads", "main"), "w") as f:
    f.write(commit_sha + "\n")

# 5. Write the index file (simple v2 format)
# Git index v2 header: "DIRC" + version(4) + entry_count(4)
# Each entry has a fixed header then variable parts
import struct

def make_index_entry(mode, ctime, mtime, sha_hex, flags, filename):
    """Create a single index entry (32+ bytes fixed header)."""
    entry = struct.pack(">I", ctime[0])      # ctime sec
    entry += struct.pack(">I", ctime[1])      # ctime nsec
    entry += struct.pack(">I", mtime[0])      # mtime sec
    entry += struct.pack(">I", mtime[1])      # mtime nsec
    entry += struct.pack(">I", os.stat(filepath).st_dev)
    entry += struct.pack(">I", os.stat(filepath).st_ino)
    entry += struct.pack(">I", os.stat(filepath).st_uid)
    entry += struct.pack(">I", os.stat(filepath).st_gid)
    entry += struct.pack(">I", os.stat(filepath).st_size)
    entry += struct.pack(">I", mode)          # mode
    entry += bytes.fromhex(sha_hex)           # SHA1 (20 bytes)
    entry += struct.pack(">H", flags)         # flags (2 bytes)
    # variable part
    entry += filename.encode() + b"\0"
    return entry

idx = struct.pack(">4sII", b"DIRC", 2, 1)  # signature, version 2, 1 entry
idx += make_index_entry(0o100644, (timestamp, 0), (timestamp, 0), blob_sha, 0, ".gitignore")

with open(os.path.join(gitdir, "index"), "wb") as f:
    f.write(idx)

print(f"\nDone! Repository created with commit {commit_sha}")
