# Test cases using bash /dev/tcp
test_case() {
    input="$1"
    expected="$2"
    result=$(timeout 2 bash -c "echo '$input' > /dev/tcp/localhost/6767; cat < /dev/tcp/localhost/6767" 2>/dev/null)
    if [ "$result" = "$expected" ]; then
        echo "PASS: '$input' -> '$result'"
    else
        echo "FAIL: '$input' -> '$result' (expected '$expected')"
    fi
}

