{"path": "/workspace/mathd.c", "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <arpa/inet.h>\n#include <ctype.h>\n#include <math.h>\n\n#define PORT 6767\n#define MAX_LINE 4096\n\n/* Parser state */\ntypedef struct {\n    const char *ptr;\n    int valid;\n} Parser;\n\nstatic void skip_whitespace(Parser *p) {\n    while (*p->ptr && isspace((unsigned char)*p->ptr)) {\n        p->ptr++;\n    }\n}\n\nstatic void set_invalid(Parser *p) {\n    p->valid = 0;\n}\n\nstatic int is_end(Parser *p) {\n    skip_whitespace(p);\n    return *p->ptr == '\\0';\n}\n\n/* Parse a number */\nstatic double parse_number(Parser *p) {\n    if (*p->ptr == '\\0' || !isdigit((unsigned char)*p->ptr) && *p->ptr != '.') {\n        set_invalid(p);\n        return NAN;\n    }\n    \n    char *end;\n    double result = strtod(p->ptr, &end);\n    if (end == p->ptr) {\n        set_invalid(p);\n        return NAN;\n    }\n    p->ptr = end;\n    return result;\n}\n\n/* Forward declarations */\nstatic double parse_expression(Parser *p);\n\n/* Parse a factor: number or (expression) */\nstatic double parse_factor(Parser *p) {\n    skip_whitespace(p);\n    \n    if (*p->ptr == '\\0') {\n        set_invalid(p);\n        return NAN;\n    }\n    \n    if (*p->ptr == '(') {\n        p->ptr++; /* consume '(' */\n        double result = parse_expression(p);\n        if (!p->valid) return NAN;\n        \n        skip_whitespace(p);\n        if (*p->ptr != ')') {\n            set_invalid(p);\n            return NAN;\n        }\n        p->ptr++; /* consume ')' */\n        return result;\n    }\n    \n    return parse_number(p);\n}\n\n/* Parse a term: factor * factor * ... */\nstatic double parse_term(Parser *p) {\n    double left = parse_factor(p);\n    if (!p->valid) return NAN;\n    \n    skip_whitespace(p);\n    \n    while (*p->ptr == '*') {\n        p->ptr++; /* consume '*' */\n        skip_whitespace(p);\n        \n        double right = parse_factor(p);\n        if (!p->valid) return NAN;\n        \n        left *= right;\n        skip_whitespace(p);\n    }\n    \n    return left;\n}\n\n/* Parse an expression: term +/- term +/- ... */\nstatic double parse_expression(Parser *p) {\n    double left = parse_term(p);\n    if (!p->valid) return NAN;\n    \n    skip_whitespace(p);\n    \n    while (*p->ptr == '+' || *p->ptr == '-') {\n        char op = *p->ptr;\n        p->ptr++; /* consume operator */\n        skip_whitespace(p);\n        \n        double right = parse_term(p);\n        if (!p->valid) return NAN;\n        \n        if (op == '+') {\n            left += right;\n        } else {\n            left -= right;\n        }\n        skip_whitespace(p);\n    }\n    \n    return left;\n}\n\n/* Evaluate an expression string. Returns NaN on error. */\nstatic double evaluate(const char *expr) {\n    Parser p = { .ptr = expr, .valid = 1 };\n    \n    double result = parse_expression(&p);\n    if (!p.valid) return NAN;\n    \n    skip_whitespace(&p);\n    if (*p.ptr != '\\0') {\n        return NAN; /* trailing garbage */\n    }\n    \n    return result;\n}\n\nint main(void) {\n    int listenfd, connfd;\n    struct sockaddr_in server_addr, client_addr;\n    socklen_t client_len = sizeof(client_addr);\n    char buffer[MAX_LINE];\n    ssize_t n;\n    \n    listenfd = socket(AF_INET, SOCK_STREAM, 0);\n    if (listenfd < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n    \n    int opt = 1;\n    setsockopt(listenfd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));\n    \n    memset(&server_addr, 0, sizeof(server_addr));\n    server_addr.sin_family = AF_INET;\n    server_addr.sin_addr.s_addr = INADDR_ANY;\n    server_addr.sin_port = htons(PORT);\n    \n    if (bind(listenfd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {\n        perror(\"bind\");\n        close(listenfd);\n        return 1;\n    }\n    \n    if (listen(listenfd, 10) < 0) {\n        perror(\"listen\");\n        close(listenfd);\n        return 1;\n    }\n    \n    while (1) {\n        connfd = accept(listenfd, (struct sockaddr *)&client_addr, &client_len);\n        if (connfd < 0) {\n            perror(\"accept\");\n            continue;\n        }\n        \n        n = recv(connfd, buffer, sizeof(buffer) - 1, 0);\n        if (n < 0) {\n            perror(\"recv\");\n            close(connfd);\n            continue;\n        }\n        if (n == 0) {\n            close(connfd);\n            continue;\n        }\n        \n        buffer[n] = '\\0';\n        \n        /* Remove trailing newline */\n        size_t len = strlen(buffer);\n        while (len > 0 && (buffer[len - 1] == '\\n' || buffer[len - 1] == '\\r')) {\n            buffer[--len] = '\\0';\n        }\n        \n        double result = evaluate(buffer);\n        \n        char response[MAX_LINE];\n        if (isnan(result)) {\n            snprintf(response, sizeof(response), \"NaN\\n\");\n        } else {\n            /* Format the result - remove trailing zeros after decimal point */\n            if (result == (long long)result) {\n                snprintf(response, sizeof(response), \"%lld\\n\", (long long)result);\n            } else {\n                snprintf(response, sizeof(response), \"%g\\n\", result);\n            }\n        }\n        \n        send(connfd, response, strlen(response), 0);\n        close(connfd);\n    }\n    \n    close(listenfd);\n    return 0;\n}\n"}
