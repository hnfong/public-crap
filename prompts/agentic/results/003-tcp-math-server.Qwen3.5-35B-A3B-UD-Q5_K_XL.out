import socket

def test(expr):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect(('localhost', 6767))
    s.sendall((expr + '\n').encode())
    response = s.recv(1024).decode().strip()
    s.close()
    print(f"'{expr}' -> '{response}'")

test("2+4")
test("10-3")
test("5*6")
test("(2+3)*4")
test("((1+2)*(3+4))")
test("2+3*4")
