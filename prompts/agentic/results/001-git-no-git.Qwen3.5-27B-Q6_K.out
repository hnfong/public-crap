[tool call: bash]
$ python3 << 'EOF'
import os
import zlib
import hashlib
import time
from datetime import datetime

# Create .git directory structure
os.makedirs('.git/objects/pack', exist_ok=True)
os.makedirs('.git/objects/info', exist_ok=True)
os.makedirs('.git/refs/heads', exist_ok=True)

# Create .gitignore file
gitignore_content = '*.pyc\n'
with open('.gitignore', 'w') as f:
    f.write(gitignore_content)

# Helper to create git objects
def create_object(content):
    """Create a git object and return its sha1"""
    data = content.encode('utf-8')
    compressed = zlib.compress(data)
    sha1 = hashlib.sha1(data).hexdigest()
    
    # Store in .git/objects
    obj_dir = f'.git/objects/{sha1[:2]}'
    os.makedirs(obj_dir, exist_ok=True)
    with open(f'{obj_dir}/{sha1[2:]}', 'wb') as f:
        f.write(compressed)
    
    return sha1

# Create blob for .gitignore
blob_content = f'blob {len(gitignore_content)}\n{gitignore_content}'
blob_sha = create_object(blob_content)
print(f'Created blob: {blob_sha}')

# Create tree object
# Tree format: mode + name + null + 20-byte-sha1 for each entry
tree_entries = b'100644 .gitignore\x00' + bytes.fromhex(blob_sha)
tree_content = f'tree {len(tree_entries)}\n'
tree_data = tree_content.encode('utf-8') + tree_entries
tree_sha = hashlib.sha1(tree_data).hexdigest()

# Store tree object
tree_compressed = zlib.compress(tree_data)
tree_dir = f'.git/objects/{tree_sha[:2]}'
os.makedirs(tree_dir, exist_ok=True)
with open(f'{tree_dir}/{tree_sha[2:]}', 'wb') as f:
    f.write(tree_compressed)
print(f'Created tree: {tree_sha}')

# Create commit object
now = int(time.time())
timestamp = datetime.fromtimestamp(now).strftime('%a %b %d %H:%M:%S %Y')
tz = '+0000'
author = f'Anonymous <anonymous@example.com> {now} {tz}'
committer = f'Anonymous <anonymous@example.com> {now} {tz}'

# Funny joke as commit message
commit_message = "Why do programmers prefer dark mode? Because light attracts bugs!\n"

commit_content = f'tree {tree_sha}\nauthor {author}\ncommitter {committer}\n\n{commit_message}'
commit_sha = create_object(commit_content)
print(f'Created commit: {commit_sha}')

# Create HEAD pointing to master
with open('.git/HEAD', 'w') as f:
    f.write('ref: refs/heads/master\n')

# Create refs/heads/master pointing to the commit
with open('.git/refs/heads/master', 'w') as f:
    f.write(commit_sha + '\n')

# Create basic config
with open('.git/config', 'w') as f:
    f.write('[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n')

print('Git repository created successfully!')
print(f'Initial commit: {commit_sha}')
EOF
