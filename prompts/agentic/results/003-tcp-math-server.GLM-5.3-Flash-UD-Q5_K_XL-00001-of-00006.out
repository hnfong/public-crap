{"path": "mathd.c", "content": "/*\n * mathd.c - tiny TCP arithmetic server.\n *\n * Listens on TCP port 6767. For each connection it reads the first line,\n * evaluates it as an arithmetic expression supporting +, -, *, parentheses\n * (arbitrarily nested) and unary +/-, and replies with one line containing\n * the result. Invalid expressions produce a line containing \"NaN\".\n *\n * Compile: clang -o mathd mathd.c\n */\n\n#include <arpa/inet.h>\n#include <ctype.h>\n#include <errno.h>\n#include <netinet/in.h>\n#include <signal.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <sys/types.h>\n#include <unistd.h>\n\n#define PORT  6767\n#define BUFSZ 4096\n\n/* ------------------------------------------------------------------ */\n/* Recursive-descent expression parser                                 */\n/*                                                                     */\n/*   expr   := term  (('+' | '-') term)*                               */\n/*   term   := factor ('*' factor)*                                    */\n/*   factor := NUMBER | '(' expr ')' | ('+' | '-') factor              */\n/* ------------------------------------------------------------------ */\n\nstatic const char *g_p; /* cursor into the input string */\nstatic int        g_err; /* set to 1 on any parse error */\n\nstatic long long parse_expr(void);\n\nstatic void skip_ws(void)\n{\n    while (*g_p == ' ' || *g_p == '\\t' || *g_p == '\\r' || *g_p == '\\f' ||\n           *g_p == '\\v')\n        g_p++;\n}\n\nstatic long long parse_factor(void)\n{\n    skip_ws();\n    if (g_err)\n        return 0;\n\n    if (*g_p == '(') {\n        g_p++;\n        long long v = parse_expr();\n        if (g_err)\n            return 0;\n        skip_ws();\n        if (*g_p != ')') {\n            g_err = 1;\n            return 0;\n        }\n        g_p++;\n        return v;\n    }\n\n    if (*g_p == '+' || *g_p == '-') { /* unary sign */\n        int neg = (*g_p == '-');\n        g_p++;\n        long long v = parse_factor();\n        if (g_err)\n            return 0;\n        return neg ? -v : v;\n    }\n\n    if (isdigit((unsigned char)*g_p)) {\n        long long v = 0;\n        int digits = 0;\n        while (isdigit((unsigned char)*g_p)) {\n            v = v * 10 + (*g_p - '0');\n            g_p++;\n            if (++digits > 18) { /* literal too large: refuse */\n                g_err = 1;\n                return 0;\n            }\n        }\n        return v;\n    }\n\n    g_err = 1; /* unexpected character (also catches '/', letters, ...) */\n    return 0;\n}\n\nstatic long long parse_term(void)\n{\n    long long v = parse_factor();\n    if (g_err)\n        return 0;\n    for (;;) {\n        skip_ws();\n        if (*g_p == '*') {\n            g_p++;\n            long long r = parse_factor();\n            if (g_err)\n                return 0;\n            if (__builtin_mul_overflow(v, r, &v)) {\n                g_err = 1;\n                return 0;\n            }\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\nstatic long long parse_expr(void)\n{\n    long long v = parse_term();\n    if (g_err)\n        return 0;\n    for (;;) {\n        skip_ws();\n        if (*g_p == '+') {\n            g_p++;\n            long long r = parse_term();\n            if (g_err)\n                return 0;\n            if (__builtin_add_overflow(v, r, &v)) {\n                g_err = 1;\n                return 0;\n            }\n        } else if (*g_p == '-') {\n            g_p++;\n            long long r = parse_term();\n            if (g_err)\n                return 0;\n            if (__builtin_sub_overflow(v, r, &v)) {\n                g_err = 1;\n                return 0;\n            }\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\n/* Evaluate a NUL-terminated expression. Returns 0 and stores the result\n * on success, -1 if the expression is invalid. */\nstatic int evaluate(const char *s, long long *out)\n{\n    g_p   = s;\n    g_err = 0;\n    long long v = parse_expr();\n    if (g_err)\n        return -1;\n    skip_ws();\n    if (*g_p != '\\0') /* trailing garbage */\n        return -1;\n    *out = v;\n    return 0;\n}\n\n/* ------------------------------------------------------------------ */\n/* Connection handling                                                 */\n/* ------------------------------------------------------------------ */\n\nstatic void write_all(int fd, const char *buf, size_t len)\n{\n    size_t off = 0;\n    while (off < len) {\n        ssize_t n = send(fd, buf + off, len - off, 0);\n        if (n <= 0) {\n            if (n < 0 && errno == EINTR)\n                continue;\n            return;\n        }\n        off += (size_t)n;\n    }\n}\n\nstatic void handle_conn(int fd)\n{\n    char   buf[BUFSZ];\n    size_t n = 0;\n\n    /* Read the first line (up to '\\n', EOF, or buffer full). */\n    while (n < BUFSZ - 1) {\n        char c;\n        ssize_t r = recv(fd, &c, 1, 0);\n        if (r <= 0)\n            break;\n        if (c == '\\n')\n            break;\n        buf[n++] = c;\n    }\n    buf[n] = '\\0';\n\n    /* Trim trailing whitespace (e.g. '\\r' from CRLF line endings). */\n    while (n > 0 && isspace((unsigned char)buf[n - 1]))\n        buf[--n] = '\\0';\n\n    long long result;\n    char out[64];\n    if (evaluate(buf, &result) == 0)\n        snprintf(out, sizeof(out), \"%lld\\n\", result);\n    else\n        snprintf(out, sizeof(out), \"NaN\\n\");\n\n    write_all(fd, out, strlen(out));\n}\n\nint main(void)\n{\n    signal(SIGCHLD, SIG_IGN); /* auto-reap forked children */\n    signal(SIGPIPE, SIG_IGN); /* dead clients: send() fails instead of SIGPIPE */\n\n    int lfd = socket(AF_INET, SOCK_STREAM, 0);\n    if (lfd < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n\n    int one = 1;\n    setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family      = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n    addr.sin_port        = htons(PORT);\n\n    if (bind(lfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {\n        perror(\"bind\");\n        return 1;\n    }\n    if (listen(lfd, 16) < 0) {\n        perror(\"listen\");\n        return 1;\n    }\n\n    for (;;) {\n        int cfd = accept(lfd, NULL, NULL);\n        if (cfd < 0) {\n            if (errno == EINTR || errno == ECONNABORTED)\n                continue;\n            perror(\"accept\");\n            continue;\n        }\n\n        pid_t pid = fork();\n        if (pid == 0) {          /* child: serve one connection and exit */\n            close(lfd);\n            handle_conn(cfd);\n            close(cfd);\n            _exit(0);\n        } else if (pid > 0) {    /* parent: keep accepting */\n            close(cfd);\n        } else {                 /* fork failed: serve inline as fallback */\n            handle_conn(cfd);\n            close(cfd);\n        }\n    }\n}\n"}
