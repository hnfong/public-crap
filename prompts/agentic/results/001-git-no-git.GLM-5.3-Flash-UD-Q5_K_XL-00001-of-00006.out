{"path": "/workspace/create_repo.py", "content": "#!/usr/bin/env python3\n\"\"\"Create a valid git repository from scratch, without the git binary.\"\"\"\nimport os, zlib, hashlib, struct, time\n\nREPO = os.getcwd()\nGIT = os.path.join(REPO, \".git\")\n\n# --- 1. working tree file -------------------------------------------------\ngitignore_path = os.path.join(REPO, \".gitignore\")\nwith open(gitignore_path, \"w\") as f:\n    f.write(\"*.pyc\\n\")\n\n# --- 2. repository skeleton ----------------------------------------------\nfor d in [\"objects/info\", \"objects/pack\", \"refs/heads\", \"refs/tags\", \"info\"]:\n    os.makedirs(os.path.join(GIT, d), exist_ok=True)\n\nwith open(os.path.join(GIT, \"HEAD\"), \"w\") as f:\n    f.write(\"ref: refs/heads/main\\n\")\n\nwith open(os.path.join(GIT, \"config\"), \"w\") as f:\n    f.write(\"[core]\\n\"\n            \"\\trepositoryformatversion = 0\\n\"\n            \"\\tfilemode = true\\n\"\n            \"\\tbare = false\\n\"\n            \"\\tlogallrefupdates = true\\n\")\n\nwith open(os.path.join(GIT, \"description\"), \"w\") as f:\n    f.write(\"Unnamed repository; edit this file 'description' to name the repository.\\n\")\n\nwith open(os.path.join(GIT, \"info/exclude\"), \"w\") as f:\n    f.write(\"# Lines that start with '#' are comments.\\n\")\n\n# --- 3. loose object writer ----------------------------------------------\ndef write_object(obj_type: str, body: bytes) -> str:\n    data = obj_type.encode() + b\" \" + str(len(body)).encode() + b\"\\x00\" + body\n    sha = hashlib.sha1(data).hexdigest()\n    dirp = os.path.join(GIT, \"objects\", sha[:2])\n    os.makedirs(dirp, exist_ok=True)\n    with open(os.path.join(dirp, sha[2:]), \"wb\") as f:\n        f.write(zlib.compress(data))\n    return sha\n\n# --- 4. blob: .gitignore --------------------------------------------------\nwith open(gitignore_path, \"rb\") as f:\n    blob_sha = write_object(\"blob\", f.read())\n\n# --- 5. tree: exactly one entry ------------------------------------------\ntree_body = b\"100644 .gitignore\\x00\" + bytes.fromhex(blob_sha)\ntree_sha = write_object(\"tree\", tree_body)\n\n# --- 6. commit ------------------------------------------------------------\nname, email = \"Pi the Coding Agent\", \"pi@example.com\"\nts, tz = int(time.time()), \"+0000\"\nmessage = (\"My repo's therapist asked about its childhood.\\n\"\n           \"\\n\"\n           \"It said: \\\"I'm an initial commit - no parents, no history, no trauma.\\\"\\n\")\n\ncommit_body = (f\"tree {tree_sha}\\n\"\n               f\"author {name} <{email}> {ts} {tz}\\n\"\n               f\"committer {name} <{email}> {ts} {tz}\\n\"\n               f\"\\n{message}\").encode()\ncommit_sha = write_object(\"commit\", commit_body)\n\n# --- 7. ref for HEAD ------------------------------------------------------\nwith open(os.path.join(GIT, \"refs/heads/main\"), \"w\") as f:\n    f.write(commit_sha + \"\\n\")\n\n# --- 8. index (version 2) so the worktree matches HEAD --------------------\nst = os.stat(gitignore_path)\nlo = lambda x: x & 0xFFFFFFFF\npath = b\".gitignore\"\nentry = struct.pack(\">IIIIIIIIII\",\n                    lo(int(st.st_ctime)), lo(st.st_ctime_ns % 1_000_000_000),\n                    lo(int(st.st_mtime)), lo(st.st_mtime_ns % 1_000_000_000),\n                    lo(st.st_dev), lo(st.st_ino),\n                    0o100644,\n                    lo(st.st_uid), lo(st.st_gid),\n                    lo(st.st_size))\nentry += bytes.fromhex(blob_sha) + struct.pack(\">H\", len(path)) + path\npad = 8 - (len(entry) % 8) or 8          # pad to multiple of 8, at least 1 NUL\nentry += b\"\\x00\" * pad\nindex_body = b\"DIRC\" + struct.pack(\">II\", 2, 1) + entry\nwith open(os.path.join(GIT, \"index\"), \"wb\") as f:\n    f.write(index_body + hashlib.sha1(index_body).digest())\n\nprint(\"blob   \", blob_sha)\nprint(\"tree   \", tree_sha)\nprint(\"commit \", commit_sha)\n"}
