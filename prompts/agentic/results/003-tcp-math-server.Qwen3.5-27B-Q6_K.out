{"path": "/workspace/mathd.c", "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <ctype.h>\n#include <errno.h>\n#include <math.h>\n\n#define PORT 6767\n#define BUFFER_SIZE 1024\n\nstatic const char *expr;\nstatic int pos;\n\nstatic double parse_expr(void);\n\nstatic double parse_term(void) {\n    double result = parse_factor();\n    \n    while (1) {\n        char op = expr[pos];\n        if (op == '*' || op == '/') {\n            pos++;\n            double factor = parse_factor();\n            if (op == '*') {\n                result *= factor;\n            } else {\n                result /= factor;\n            }\n        } else {\n            break;\n        }\n    }\n    return result;\n}\n\nstatic double parse_factor(void) {\n    while (isspace(expr[pos])) pos++;\n    \n    if (expr[pos] == '(') {\n        pos++;\n        double result = parse_expr();\n        while (isspace(expr[pos])) pos++;\n        if (expr[pos] != ')') {\n            return NAN;\n        }\n        pos++;\n        return result;\n    }\n    \n    if (expr[pos] == '-') {\n        pos++;\n        double val = parse_factor();\n        return -val;\n    }\n    \n    if (expr[pos] == '+') {\n        pos++;\n        return parse_factor();\n    }\n    \n    if (isdigit(expr[pos]) || expr[pos] == '.') {\n        char *end;\n        double val = strtod(expr + pos, &end);\n        if (end == expr + pos) {\n            return NAN;\n        }\n        pos = end - expr;\n        return val;\n    }\n    \n    return NAN;\n}\n\nstatic double parse_expr(void) {\n    double result = parse_term();\n    \n    while (1) {\n        char op = expr[pos];\n        if (op == '+' || op == '-') {\n            pos++;\n            double term = parse_term();\n            if (op == '+') {\n                result += term;\n            } else {\n                result -= term;\n            }\n        } else {\n            break;\n        }\n    }\n    return result;\n}\n\nstatic double evaluate(const char *line) {\n    expr = line;\n    pos = 0;\n    while (isspace(expr[pos])) pos++;\n    if (expr[pos] == '\\0') return NAN;\n    \n    double result = parse_expr();\n    \n    while (isspace(expr[pos])) pos++;\n    if (expr[pos] != '\\0') return NAN;\n    \n    return result;\n}\n\nstatic void handle_client(int client_fd) {\n    char buffer[BUFFER_SIZE];\n    char response[256];\n    \n    ssize_t n = read(client_fd, buffer, sizeof(buffer) - 1);\n    if (n <= 0) {\n        close(client_fd);\n        return;\n    }\n    buffer[n] = '\\0';\n    \n    char *newline = strchr(buffer, '\\n');\n    if (newline) {\n        *newline = '\\0';\n    }\n    \n    double result = evaluate(buffer);\n    \n    if (isnan(result)) {\n        snprintf(response, sizeof(response), \"NaN\\n\");\n    } else {\n        snprintf(response, sizeof(response), \"%.15g\\n\", result);\n    }\n    \n    write(client_fd, response, strlen(response));\n    close(client_fd);\n}\n\nint main(void) {\n    int server_fd;\n    struct sockaddr_in addr;\n    \n    server_fd = socket(AF_INET, SOCK_STREAM, 0);\n    if (server_fd < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n    \n    int opt = 1;\n    if (setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)) < 0) {\n        perror(\"setsockopt\");\n        close(server_fd);\n        return 1;\n    }\n    \n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = INADDR_ANY;\n    addr.sin_port = htons(PORT);\n    \n    if (bind(server_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {\n        perror(\"bind\");\n        close(server_fd);\n        return 1;\n    }\n    \n    if (listen(server_fd, 10) < 0) {\n        perror(\"listen\");\n        close(server_fd);\n        return 1;\n    }\n    \n    while (1) {\n        struct sockaddr_in client_addr;\n        socklen_t client_len = sizeof(client_addr);\n        int client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &client_len);\n        if (client_fd < 0) {\n            perror(\"accept\");\n            continue;\n        }\n        handle_client(client_fd);\n    }\n    \n    return 0;\n}\n"}
