$ cd /workspace && ls -la && cat > /tmp/mkrepo.py << 'EOF'
import os, zlib, hashlib, time

repo = '/workspace'
git = os.path.join(repo, '.git')

# Working file
with open(os.path.join(repo, '.gitignore'), 'wb') as f:
    f.write(b'*.pyc\n')

def git_obj(kind, data):
    header = (kind + ' ' + str(len(data))).encode()
    return header + b'\x00' + data

def sha1(kind, data):
    return hashlib.sha1(git_obj(kind, data)).hexdigest()

def write_obj(kind, data):
    oid = sha1(kind, data)
    path = os.path.join(git, 'objects', oid[:2], oid[2:])
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'wb') as f:
        f.write(zlib.compress(git_obj(kind, data)))
    return oid

os.makedirs(os.path.join(git, 'objects'), exist_ok=True)
os.makedirs(os.path.join(git, 'refs', 'heads'), exist_ok=True)

# Blob
blob_sha = write_obj('blob', b'*.pyc\n')
print('blob:', blob_sha)

# Tree
tree_entry = '100644 .gitignore\x00' + bytes.fromhex(blob_sha)
tree_data = tree_entry
tree_sha = write_obj('tree', tree_data)
print('tree:', tree_sha)

# Commit
author = 'Anonymous <anon@example.com>'
now = int(time.time())
tz = '+0000'
commit_data = (
    'tree ' + tree_sha + '\n'
    'author ' + author + ' ' + str(now) + ' ' + tz + '\n'
    'committer ' + author + ' ' + str(now) + ' ' + tz + '\n'
    '\n'
    'Why did the programmer quit his job? Because he didn\u2019t get arrays.\n'
).encode()
commit_sha = write_obj('commit', commit_data)
print('commit:', commit_sha)

# HEAD
with open(os.path.join(git, 'HEAD'), 'w') as f:
    f.write('ref: refs/heads/master\n')

# config
with open(os.path.join(git, 'config'), 'w') as f:
    f.write('[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n')

# refs
with open(os.path.join(git, 'refs', 'heads', 'master'), 'w') as f:
    f.write(commit_sha + '\n')

print('done')
EOF
