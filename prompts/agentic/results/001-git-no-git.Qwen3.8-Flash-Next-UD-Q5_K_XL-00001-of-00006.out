{"path": "/workspace/make_repo.py", "content": "#!/usr/bin/env python3\n\"\"\"\nBuild a valid git repository from scratch -- no `git` binary involved.\n\nWe hand-write the on-disk format:\n  .git/HEAD, .git/config, .git/description\n  .git/objects/xx/yyyy...        (zlib-compressed loose objects)\n  .git/refs/heads/main           (raw commit sha)\n  .git/logs/...                  (reflogs)\n  .git/index                     (v2 index, so `git status` is clean)\n\"\"\"\nimport hashlib\nimport os\nimport struct\nimport time\nimport zlib\n\nROOT = os.path.dirname(os.path.abspath(__file__))\nGIT = os.path.join(ROOT, \".git\")\n\nNAME = \"Python Git Wrangler\"\nEMAIL = \"wrangler@example.com\"\nTZ = \"+0000\"\n\nIGNORE_CONTENT = (\n    \"# Byte-compiled Python artifacts: seen, unloved, never invited back.\\n\"\n    \"*.pyc\\n\"\n)\n\nMESSAGE = (\n    \"Why do programmers prefer dark mode?\\n\"\n    \"\\n\"\n    \"Because light attracts bugs. The .pyc ones especially, so they are now\\n\"\n    \"ignored. (I also told my computer I needed a break, and now it will not\\n\"\n    \"stop sending me KitKats.)\\n\"\n)\n\n\ndef now_stamp():\n    ts = int(time.time())\n    return ts, TZ\n\n\ndef write_object(obj_type: bytes, payload: bytes) -> str:\n    \"\"\"Write a loose object, return its SHA-1.\"\"\"\n    raw = obj_type + b\" \" + str(len(payload)).encode() + b\"\\0\" + payload\n    sha = hashlib.sha1(raw).hexdigest()\n    dirname = os.path.join(GIT, \"objects\", sha[:2])\n    os.makedirs(dirname, exist_ok=True)\n    path = os.path.join(dirname, sha[2:])\n    if not os.path.exists(path):\n        with open(path, \"wb\") as fh:\n            fh.write(zlib.compress(raw, 1))\n            fh.flush()\n            os.fsync(fh.fileno())\n    return sha\n\n\ndef write_bytes(path: str, data: bytes):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    with open(path, \"wb\") as fh:\n        fh.write(data)\n        fh.flush()\n        os.fsync(fh.fileno())\n\n\ndef ident(ts: int, tz: str) -> bytes:\n    return b\"%s <%s> %d %s\" % (NAME.encode(), EMAIL.encode(), ts, tz.encode())\n\n\ndef build_index(entries):\n    \"\"\"entries: list of (path, mode, sha, ctime, mtime, size)\"\"\"\n    body = b\"\"\n    for path, mode, sha, ctime, mtime, size in entries:\n        pb = path.encode()\n        name_len = len(pb)\n        assert name_len < 0xFFF\n        flags = name_len  # stage 0\n        fixed = struct.pack(\n            \">IIIIIIII I20sH\",\n            ctime, 0,          # ctime sec, nsec\n            mtime, 0,          # mtime sec, nsec\n            mode, 0,           # mode, uid  (uid/gid left 0)\n            0,                 # gid\n            size,\n            0,                 # placeholder, replaced below\n            bytes.fromhex(sha),\n            flags,\n        )\n        # The struct above has one extra uint32; drop it and rebuild cleanly.\n        fixed = struct.pack(\n            \">IIIIIII 20sH\",\n            ctime, 0,\n            mtime, 0,\n            mode,\n            0,                 # uid\n            0,                 # gid\n            size,\n            bytes.fromhex(sha),\n            flags,\n        )\n        # entry length = 12-byte header-equivalent + path + NUL, padded to 8\n        entry_len = len(fixed) + len(pb) + 1\n        pad = 8 - (entry_len % 8)\n        body += fixed + pb + b\"\\0\" * (1 + pad)\n\n    header = b\"DIRC\" + struct.pack(\">III\", 2, len(entries), 0)\n    tree_ext = b\"TREE\" + struct.pack(\">I\", 0)\n    data = header + body + tree_ext\n    return data + hashlib.sha1(data).digest()\n\n\ndef main():\n    # ---- skeleton -------------------------------------------------------\n    for d in (\"objects/info\", \"objects/pack\", \"refs/heads\", \"refs/tags\",\n              \"refs/remotes/origin\", \"logs/refs/heads\", \"branches\"):\n        os.makedirs(os.path.join(GIT, d), exist_ok=True)\n\n    write_bytes(os.path.join(GIT, \"description\"),\n                b\"Unnamed repository; edit this file 'description' to name the repository.\\n\")\n    write_bytes(os.path.join(GIT, \"COMMIT_EDITMSG\"), MESSAGE.encode())\n    write_bytes(os.path.join(GIT, \"config\"), (\n        \"[core]\\n\"\n        \"\\trepositoryformatversion = 0\\n\"\n        \"\\tfilemode = true\\n\"\n        \"\\tbare = false\\n\"\n        \"\\tlogallrefupdates = true\\n\"\n        \"[user]\\n\"\n        \"\\tname = %s\\n\"\n        \"\\temail = %s\\n\" % (NAME, EMAIL)\n    ).encode())\n\n    # ---- working tree file ---------------------------------------------\n    ignore_path = os.path.join(ROOT, \".gitignore\")\n    write_bytes(ignore_path, IGNORE_CONTENT.encode())\n    st = os.stat(ignore_path)\n\n    # ---- objects --------------------------------------------------------\n    blob = write_object(b\"blob\", IGNORE_CONTENT.encode())\n    tree_entry = b\"100644 .gitignore\\0\" + bytes.fromhex(blob)\n    tree = write_object(b\"tree\", tree_entry)\n\n    ts, tz = now_stamp()\n    commit_payload = (\n        b\"tree \" + tree.encode() + b\"\\n\"\n        b\"author \" + ident(ts, tz) + b\"\\n\"\n        b\"committer \" + ident(ts, tz) + b\"\\n\"\n        b\"\\n\"\n        + MESSAGE.encode()\n    )\n    commit = write_object(b\"commit\", commit_payload)\n\n    # ---- refs + HEAD + reflog ------------------------------------------\n    branch = \"main\"\n    write_bytes(os.path.join(GIT, \"refs\", \"heads\", branch), (commit + \"\\n\").encode())\n    write_bytes(os.path.join(GIT, \"HEAD\"), (\"ref: refs/heads/%s\\n\" % branch).encode())\n\n    zero = \"0\" * 40\n    reflog_line = (\"%s %s %s\\tcommit (initial): %s\\n\" % (\n        zero, commit, ident(ts, tz).decode(), MESSAGE.strip().replace(\"\\n\", \" \")\n    )).encode()\n    write_bytes(os.path.join(GIT, \"logs\", \"HEAD\"), reflog_line)\n    write_bytes(os.path.join(GIT, \"logs\", \"refs\", \"heads\", branch), reflog_line)\n\n    # ---- index ----------------------------------------------------------\n    index = build_index([\n        (\".gitignore\", 0o100644, blob, int(st.st_ctime), int(st.st_mtime), st.st_size),\n    ])\n    write_bytes(os.path.join(GIT, \"index\"), index)\n\n    print(\"blob    :\", blob)\n    print(\"tree    :\", tree)\n    print(\"commit  :\", commit)\n\n\nif __name__ == \"__main__\":\n    main()\n"}
