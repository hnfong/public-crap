{"path": "/workspace/mathd.c", "content": "/* mathd - simple arithmetic TCP server\n *\n * Listens on TCP port 6767. For every connection, reads the first line\n * received, evaluates it as an arithmetic expression built from +, -, *\n * and parentheses, and replies with one line containing the result.\n * Invalid expressions produce a line containing \"NaN\".\n *\n * Build: clang -o mathd mathd.c\n */\n\n#define _POSIX_C_SOURCE 200809L\n\n#include <arpa/inet.h>\n#include <ctype.h>\n#include <errno.h>\n#include <netinet/in.h>\n#include <signal.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <sys/types.h>\n#include <unistd.h>\n\n#define PORT 6767\n#define LINE_CAP 8192\n\n/* ------------------------------------------------------------------ */\n/* Expression parser (recursive descent)                               */\n/*                                                                     */\n/*   expr   := term   (('+' | '-') term)*                              */\n/*   term   := factor (('*') factor)*                                  */\n/*   factor := number | ('+' | '-') factor | '(' expr ')'              */\n/* ------------------------------------------------------------------ */\n\nstatic const char *src;\nstatic size_t src_len;\nstatic size_t src_pos;\nstatic int parse_err;\n\nstatic long long parse_expr(void);\n\nstatic void skip_ws(void)\n{\n    while (src_pos < src_len) {\n        char c = src[src_pos];\n        if (c == ' ' || c == '\\t')\n            src_pos++;\n        else\n            break;\n    }\n}\n\nstatic long long parse_factor(void)\n{\n    skip_ws();\n    if (src_pos >= src_len) {\n        parse_err = 1;\n        return 0;\n    }\n    char c = src[src_pos];\n    if (c == '(') {\n        src_pos++;\n        long long v = parse_expr();\n        if (parse_err)\n            return 0;\n        skip_ws();\n        if (src_pos >= src_len || src[src_pos] != ')') {\n            parse_err = 1;\n            return 0;\n        }\n        src_pos++;\n        return v;\n    }\n    if (c == '-' || c == '+') {\n        src_pos++;\n        long long v = parse_factor();\n        if (parse_err)\n            return 0;\n        return (c == '-') ? -v : v;\n    }\n    if (isdigit((unsigned char)c)) {\n        long long v = 0;\n        while (src_pos < src_len && isdigit((unsigned char)src[src_pos])) {\n            v = v * 10 + (src[src_pos] - '0');\n            src_pos++;\n        }\n        return v;\n    }\n    parse_err = 1;\n    return 0;\n}\n\nstatic long long parse_term(void)\n{\n    long long v = parse_factor();\n    if (parse_err)\n        return 0;\n    for (;;) {\n        skip_ws();\n        if (src_pos < src_len && src[src_pos] == '*') {\n            src_pos++;\n            long long r = parse_factor();\n            if (parse_err)\n                return 0;\n            v *= r;\n        } else {\n            return v;\n        }\n    }\n}\n\nstatic long long parse_expr(void)\n{\n    long long v = parse_term();\n    if (parse_err)\n        return 0;\n    for (;;) {\n        skip_ws();\n        if (src_pos < src_len && (src[src_pos] == '+' || src[src_pos] == '-')) {\n            char op = src[src_pos++];\n            long long r = parse_term();\n            if (parse_err)\n                return 0;\n            v = (op == '+') ? v + r : v - r;\n        } else {\n            return v;\n        }\n    }\n}\n\n/* Returns 1 and stores the value in *out on success, 0 if invalid. */\nstatic int evaluate(const char *s, long long *out)\n{\n    src = s;\n    src_len = strlen(s);\n    src_pos = 0;\n    parse_err = 0;\n\n    long long v = parse_expr();\n    if (parse_err)\n        return 0;\n    skip_ws();\n    if (src_pos != src_len)\n        return 0; /* trailing garbage */\n\n    *out = v;\n    return 1;\n}\n\n/* ------------------------------------------------------------------ */\n/* Network handling                                                    */\n/* ------------------------------------------------------------------ */\n\n/* Reads one line from fd into buf (capacity cap). Returns the line\n * length, or -1 if the line is too long. */\nstatic int read_line(int fd, char *buf, size_t cap)\n{\n    size_t n = 0;\n    buf[0] = '\\0';\n    for (;;) {\n        char tmp[256];\n        ssize_t r = read(fd, tmp, sizeof tmp);\n        if (r <= 0)\n            break;\n        for (ssize_t i = 0; i < r; i++) {\n            char ch = tmp[i];\n            if (ch == '\\n' || ch == '\\r') {\n                buf[n] = '\\0';\n                return (int)n;\n            }\n            if (n + 1 >= cap)\n                return -1;\n            buf[n++] = ch;\n        }\n    }\n    buf[n] = '\\0';\n    return (int)n;\n}\n\nstatic void write_all(int fd, const char *s)\n{\n    size_t len = strlen(s);\n    size_t off = 0;\n    while (off < len) {\n        ssize_t w = write(fd, s + off, len - off);\n        if (w < 0) {\n            if (errno == EINTR)\n                continue;\n            return;\n        }\n        off += (size_t)w;\n    }\n}\n\nstatic void handle_connection(int fd)\n{\n    char line[LINE_CAP];\n    char resp[64];\n    long long result = 0;\n    int ok = (read_line(fd, line, sizeof line) >= 0) && evaluate(line, &result);\n\n    if (ok)\n        snprintf(resp, sizeof resp, \"%lld\\n\", result);\n    else\n        snprintf(resp, sizeof resp, \"NaN\\n\");\n\n    write_all(fd, resp);\n    close(fd);\n}\n\nint main(void)\n{\n    signal(SIGPIPE, SIG_IGN);\n    signal(SIGCHLD, SIG_IGN); /* auto-reap forked clients */\n\n    int listen_fd = socket(AF_INET, SOCK_STREAM, 0);\n    if (listen_fd < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n\n    int one = 1;\n    setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof addr);\n    addr.sin_family = AF_INET;\n    addr.sin_port = htons(PORT);\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n\n    if (bind(listen_fd, (struct sockaddr *)&addr, sizeof addr) < 0) {\n        perror(\"bind\");\n        return 1;\n    }\n    if (listen(listen_fd, 64) < 0) {\n        perror(\"listen\");\n        return 1;\n    }\n\n    for (;;) {\n        int conn = accept(listen_fd, NULL, NULL);\n        if (conn < 0) {\n            if (errno == EINTR)\n                continue;\n            perror(\"accept\");\n            continue;\n        }\n        pid_t pid = fork();\n        if (pid == 0) {\n            close(listen_fd);\n            handle_connection(conn);\n            _exit(0);\n        }\n        close(conn);\n    }\n    return 0;\n}\n"}
