import socket

def q(line):
    s=socket.create_connection(('127.0.0.1',6767),timeout=3)
    s.sendall(line.encode() + b"\n")
    s.settimeout(3)
    data=b''
    try:
        while True:
            c=s.recv(4096)
            if not c: break
            data+=c
    except socket.timeout:
        pass
    s.close()
    return data.decode()

tests = [
    ("2+4","6\n"),
    ("2*3+4","10\n"),
    ("(2+3)*(4-1)","15\n"),
    ("((1+2)*(3+4))","21\n"),
    ("10-4-3","3\n"),
    ("2*3*4","24\n"),
    ("-5*2","-10\n"),
    ("3-4","-1\n"),
    ("2+","NaN\n"),
    ("2 3","NaN\n"),
    ("abc","NaN\n"),
    ("(1+2","NaN\n"),
    ("1+2)","NaN\n"),
    ("2.5+1","NaN\n"),
    ("","NaN\n"),
    ("   ","NaN\n"),
    ("7","7\n"),
    ("  ( 1 + 2 ) * 3  ","9\n"),
    ("1+2*3-4*(5-2)","1\n"),
    ("2  +  4","6\n"),
    ("((((5))))","5\n"),
]
