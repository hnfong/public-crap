import socket, threading

results = {}
def worker(i, expr):
    s=socket.create_connection(('127.0.0.1',6767),timeout=5)
    s.sendall((expr+"\n").encode())
    s.settimeout(5)
    data=b''
    try:
        while True:
            c=s.recv(4096)
            if not c: break
            data+=c
    except socket.timeout:
        pass
    results[i]=data.decode()

# 20 concurrent connections
threads=[threading.Thread(target=worker,args=(i, f"{i}*{i}")) for i in range(20)]
for t in threads: t.start()
for t in threads: t.join()
bad=[(i,r) for i,r in sorted(results.items()) if r!=f"{i*i}\n"]
print("concurrency:", "OK" if not bad else f"FAIL {bad}")

# two lines: only first evaluated
s=socket.create_connection(('127.0.0.1',6767),timeout=3)
s.sendall(b"3+4\n999+999\n")
s.settimeout(3)
print("two lines:", repr(s.recv(100).decode()))
s.close()

# server still alive after all that
s=socket.create_connection(('127.0.0.1',6767),timeout=3)
s.sendall(b"100+1\n"); s.settimeout(3)
print("still alive:", repr(s.recv(100).decode()))
EOF
