{"content": "import hashlib\nimport os\nimport struct\nimport time\nimport zlib\n\nROOT = \"/workspace\"\nGIT = os.path.join(ROOT, \".git\")\n\n# --- working tree file -------------------------------------------------------\ngitignore_path = os.path.join(ROOT, \".gitignore\")\nwith open(gitignore_path, \"wb\") as f:\n    f.write(b\"*.pyc\\n\")\n\n# --- git object helpers ------------------------------------------------------\ndef hash_object(obj_type: bytes, content: bytes) -> str:\n    store = obj_type + b\" \" + str(len(content)).encode() + b\"\\0\" + content\n    return hashlib.sha1(store).hexdigest(), store\n\ndef write_object(obj_type: bytes, content: bytes) -> str:\n    sha, store = hash_object(obj_type, content)\n    obj_dir = os.path.join(GIT, \"objects\", sha[:2])\n    os.makedirs(obj_dir, exist_ok=True)\n    obj_path = os.path.join(obj_dir, sha[2:])\n    with open(obj_path, \"wb\") as f:\n        f.write(zlib.compress(store))\n    return sha\n\n# --- create repo skeleton ----------------------------------------------------\nfor d in (\"objects\", \"refs/heads\", \"info\", \"hooks\"):\n    os.makedirs(os.path.join(GIT, d), exist_ok=True)\n\nwith open(os.path.join(GIT, \"HEAD\"), \"w\") as f:\n    f.write(\"ref: refs/heads/main\\n\")\n\nwith open(os.path.join(GIT, \"config\"), \"w\") as f:\n    f.write(\n        \"[core]\\n\"\n        \"\\trepositoryformatversion = 0\\n\"\n        \"\\tfilemode = true\\n\"\n        \"\\tbare = false\\n\"\n        \"\\tlogallrefupdates = true\\n\"\n    )\n\nwith open(os.path.join(GIT, \"description\"), \"w\") as f:\n    f.write(\"Unnamed repository; edit this file 'description' to name the repository.\\n\")\n\nwith open(os.path.join(GIT, \"info\", \"exclude\"), \"w\") as f:\n    f.write(\"# git ls-files --others --exclude-from=.git/info/exclude\\n\")\n\n# --- blob --------------------------------------------------------------------\nwith open(gitignore_path, \"rb\") as f:\n    blob_content = f.read()\nblob_sha = write_object(b\"blob\", blob_content)\n\n# --- tree (single entry: .gitignore, mode 100644) ----------------------------\nname = b\".gitignore\"\nentry = b\"100644 \" + name + b\"\\0\" + bytes.fromhex(blob_sha)\ntree_content = entry\ntree_sha = write_object(b\"tree\", tree_content)\n\n# --- commit ------------------------------------------------------------------\nnow = int(time.time())\ntz = time.strftime(\"%z\", time.localtime(now)) or \"+0000\"\nauthor = f\"Pi Agent <pi@example.com> {now} {tz}\"\nmessage = \"Initial commit: I would tell you a joke about .gitignore, but you'd probably just ignore it.\\n\"\ncommit_content = (\n    f\"tree {tree_sha}\\n\"\n    f\"author {author}\\n\"\n    f\"committer {author}\\n\"\n    f\"\\n\"\n    f\"{message}\"\n).encode()\ncommit_sha = write_object(b\"commit\", commit_content)\n\n# --- ref ---------------------------------------------------------------------\nwith open(os.path.join(GIT, \"refs\", \"heads\", \"main\"), \"w\") as f:\n    f.write(commit_sha + \"\\n\")\n\n# --- index (so the repo is consistent with the working tree) -----------------\nst = os.stat(gitignore_path)\nname_b = b\".gitignore\"\nfixed = struct.pack(\n    \">10I20sH\",\n    int(st.st_ctime), st.st_ctimensec if hasattr(st, \"st_ctimensec\") else 0,\n    int(st.st_mtime), st.st_mtimensec if hasattr(st, \"st_mtimensec\") else 0,\n    st.st_dev & 0xFFFFFFFF, st.st_ino & 0xFFFFFFFF,\n    0o100644,\n    st.st_uid, st.st_gid,\n    st.st_size,\n    bytes.fromhex(blob_sha),\n    len(name_b) & 0x0FFF,\n)\nentry = fixed + name_b + b\"\\0\"\nentry += b\"\\0\" * ((8 - (len(entry) % 8)) % 8)\n\nbody = b\"DIRC\" + struct.pack(\">II\", 2, 1) + entry\nindex_bytes = body + hashlib.sha1(body).digest()\nwith open(os.path.join(GIT, \"index\"), \"wb\") as f:\n    f.write(index_bytes)\n\nprint(\"blob   \", blob_sha)\nprint(\"tree   \", tree_sha)\nprint(\"commit \", commit_sha)\n", "path": "/tmp/build_repo.py"}
