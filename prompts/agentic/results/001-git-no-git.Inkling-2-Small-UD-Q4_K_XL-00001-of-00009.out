import hashlib, os, struct, zlib

GIT = "/workspace/.git"

def read_obj(sha):
    raw = zlib.decompress(open(f"{GIT}/objects/{sha[:2]}/{sha[2:]}", "rb").read())
    # verify filename matches content hash
    assert hashlib.sha1(raw).hexdigest() == sha, "object hash mismatch"
    header, content = raw.split(b"\0", 1)
    typ, size = header.split(b" ", 1)
    assert int(size) == len(content), "size mismatch"
    return typ.decode(), content

# HEAD -> ref -> commit
head = open(f"{GIT}/HEAD").read().strip()
ref = head.split(": ", 1)[1]
commit_sha = open(f"{GIT}/{ref}").read().strip()
print("HEAD ->", ref, "->", commit_sha)

typ, commit = read_obj(commit_sha)
print("commit object OK, type:", typ)
print(commit.decode())

tree_sha = next(l.split()[1] for l in commit.decode().splitlines() if l.startswith("tree "))
typ, tree = read_obj(tree_sha)
print("tree object OK, type:", typ)

# parse tree entries
entries, i = [], 0
while i < len(tree):
    j = tree.index(b" ", i)
    mode = tree[i:j].decode()
    k = tree.index(b"\0", j)
    name = tree[j+1:k].decode()
    sha = tree[k+1:k+21].hex()
    entries.append((mode, name, sha))
    i = k + 21
print("tree entries:", entries)
assert len(entries) == 1 and entries[0][1] == ".gitignore", "commit must contain exactly one file: .gitignore"

typ, blob = read_obj(entries[0][2])
print("blob object OK, type:", typ, "content:", blob)
assert blob == open("/workspace/.gitignore", "rb").read()
assert b"*.pyc" in blob

# index: verify structure and trailing checksum
idx = open(f"{GIT}/index", "rb").read()
assert idx[:4] == b"DIRC"
version, count = struct.unpack(">II", idx[4:12])
assert version == 2 and count == 1
assert hashlib.sha1(idx[:-20]).digest() == idx[-20:], "index checksum mismatch"
off = 12
(ct_s, ct_n, mt_s, mt_n, dev, ino, mode, uid, gid, size) = struct.unpack(">10I", idx[off:off+40])
off += 40
sha = idx[off:off+20].hex(); off += 20
flags, = struct.unpack(">H", idx[off:off+2]); off += 2
namelen = flags & 0xFFF
name = idx[off:off+namelen].decode()
print(f"index OK: version={version} entries={count} file={name} mode={oct(mode)} size={size} sha={sha}")
assert sha == entries[0][2]

# exactly one commit reachable: commit has no parent line
assert "parent " not in commit.decode()
print("\nALL CHECKS PASSED")
EOF
