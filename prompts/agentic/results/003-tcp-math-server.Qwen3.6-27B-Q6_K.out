{"path": "/workspace/mathd.c", "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ctype.h>\n#include <errno.h>\n#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <unistd.h>\n#include <signal.h>\n\n/* ---------- recursive-descent arithmetic evaluator ---------- */\n\nstatic const char *input;       /* pointer into the expression string */\nstatic int  error;              /* set on parse failure */\n\nstatic void skip_spaces(void) {\n    while (*input && isspace((unsigned char)*input)) input++;\n}\n\n/* factor -> NUMBER | '(' expr ')' | ('+'|'-') factor */\nstatic double factor(void) {\n    skip_spaces();\n\n    /* unary +/- */\n    if (*input == '+') { input++; return factor(); }\n    if (*input == '-') { input++; return -factor(); }\n\n    /* parenthesised sub-expression */\n    if (*input == '(') {\n        input++;                       /* consume '(' */\n        double v = expr();\n        skip_spaces();\n        if (*input != ')') { error = 1; return 0; }\n        input++;                       /* consume ')' */\n        return v;\n    }\n\n    /* number: optional digits, optional decimal point, optional digits */\n    int has_digit = 0;\n    double v;\n    char *end;\n    errno = 0;\n    v = strtod(input, &end);\n    if (end == input || errno != 0) { error = 1; return 0; }\n    has_digit = (end != input);\n    input = end;\n    if (!has_digit) { error = 1; return 0; }\n    return v;\n}\n\n/* term -> factor { '*' factor } */\nstatic double term(void) {\n    double v = factor();\n    if (error) return 0;\n    for (;;) {\n        skip_spaces();\n        if (*input == '*') {\n            input++;\n            double r = factor();\n            if (error) return 0;\n            v *= r;\n        } else break;\n    }\n    return v;\n}\n\n/* expr -> term { ('+'|'-') term } */\nstatic double expr(void) {\n    double v = term();\n    if (error) return 0;\n    for (;;) {\n        skip_spaces();\n        if (*input == '+') { input++; double r = term(); if (error) return 0; v += r; }\n        else if (*input == '-') { input++; double r = term(); if (error) return 0; v -= r; }\n        else break;\n    }\n    return v;\n}\n\n/*\n * Evaluate the expression string `s`.  On success the result is printed to\n * `buf` and 0 is returned.  On failure \"NaN\" is written to `buf` and -1\n * returned.\n */\nstatic int evaluate(const char *s, char *buf, size_t bufsz) {\n    input = s;\n    error = 0;\n    double result = expr();\n    skip_spaces();\n    /* trailing junk is an error */\n    if (*input != '\\0' || error) {\n        snprintf(buf, bufsz, \"NaN\\n\");\n        return -1;\n    }\n    if (result == (long long)result)\n        snprintf(buf, bufsz, \"%.0f\\n\", result);\n    else\n        snprintf(buf, bufsz, \"%g\\n\", result);\n    return 0;\n}\n\n/* ---------- TCP server ---------- */\n\nstatic int make_server_socket(int port) {\n    int sd = socket(AF_INET, SOCK_STREAM, 0);\n    if (sd < 0) perror(\"socket\"), exit(1);\n\n    int on = 1;\n    setsockopt(sd, SOL_SOCKET, SO_REUSEADDR, &on, sizeof on);\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof addr);\n    addr.sin_family      = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n    addr.sin_port        = htons(port);\n\n    if (bind(sd, (struct sockaddr *)&addr, sizeof addr) < 0)\n        perror(\"bind\"), exit(1);\n    if (listen(sd, 128) < 0)\n        perror(\"listen\"), exit(1);\n    return sd;\n}\n\nint main(void) {\n    signal(SIGPIPE, SIG_IGN);\n\n    int server = make_server_socket(6767);\n    fprintf(stderr, \"mathd listening on port 6767\\n\");\n\n    for (;;) {\n        struct sockaddr_in client_addr;\n        socklen_t          client_len = sizeof client_addr;\n        int                clfd       = accept(server, (struct sockaddr *)&client_addr, &client_len);\n        if (clfd < 0) { perror(\"accept\"); continue; }\n\n        /* read one line */\n        char line[4096];\n        ssize_t n = 0;\n        char   c;\n        while (n < (ssize_t)(sizeof line - 1)) {\n            ssize_t r = read(clfd, &c, 1);\n            if (r <= 0) break;\n            if (c == '\\n') { line[n] = '\\0'; break; }\n            if (c != '\\r') line[n++] = c;\n        }\n\n        char resp[256];\n        evaluate(line, resp, sizeof resp);\n        write(clfd, resp, strlen(resp));\n        close(clfd);\n    }\n}\n"}
