def median(xs):
    """Return the median of a non-empty list of numbers."""
    s = sorted(xs)
    n = len(s)
    return s[n // 2]

[toolResult]
import unittest

from median import median


class TestMedian(unittest.TestCase):
    def test_odd_count(self):
        self.assertEqual(median([1, 2, 3]), 2)

    def test_even_count(self):
        self.assertEqual(median([1, 2, 3, 4]), 2.5)

    def test_single(self):
        self.assertEqual(median([7]), 7)

    def test_unsorted(self):
        self.assertEqual(median([5, 1, 3]), 3)

    def test_floats(self):
        self.assertEqual(median([1.0, 2.0]), 1.5)


if __name__ == "__main__":
    unittest.main()

[thinking]
The bug is clear: the `median` function only returns the middle element for odd-length lists. For even-length lists, it should return the average of the two middle elements. Currently it just returns `s[n // 2]`, which is the upper middle element (e.g., for `[1,2,3,4]`, it returns `s[2] = 3` instead of `(s[1] + s[2]) / 2 = 2.5`).
