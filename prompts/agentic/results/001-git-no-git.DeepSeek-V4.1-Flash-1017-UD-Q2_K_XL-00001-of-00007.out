$ python3 - <<'PY'
import hashlib
import os
import struct
import time
import zlib

repo = os.getcwd()
git_dir = os.path.join(repo, '.git')
assert not os.path.exists(git_dir), '.git already exists'

os.makedirs(os.path.join(git_dir, 'objects'))
os.makedirs(os.path.join(git_dir, 'refs', 'heads'))
os.makedirs(os.path.join(git_dir, 'info'))

# Working-tree file that will be the sole entry in the initial commit.
with open('.gitignore', 'wb') as f:
    f.write(b'*.pyc\n')

def write_object(kind, data):
    body = kind.encode() + b' ' + str(len(data)).encode() + b'\0' + data
    oid = hashlib.sha1(body).digest()
    hex_oid = oid.hex()
    obj_dir = os.path.join(git_dir, 'objects', hex_oid[:2])
    os.makedirs(obj_dir, exist_ok=True)
    with open(os.path.join(obj_dir, hex_oid[2:]), 'wb') as f:
        f.write(zlib.compress(body))
    return oid

# Blob for .gitignore.
with open('.gitignore', 'rb') as f:
    ignore_data = f.read()
blob_oid = write_object('blob', ignore_data)

# Tree with exactly one file: .gitignore
tree_data = b'100644 .gitignore\0' + blob_oid
tree_oid = write_object('tree', tree_data)

# Initial commit.
message = b"Why do programmers prefer dark mode? Because light attracts bugs.\n"
timestamp = int(time.time())
tz = b'+0000'
identity = b'Joke Bot <joke@example.com>'
commit_data = (
    b'tree ' + tree_oid.hex().encode() + b'\n' +
    b'author ' + identity + b' ' + str(timestamp).encode() + b' ' + tz + b'\n' +
    b'committer ' + identity + b' ' + str(timestamp).encode() + b' ' + tz + b'\n' +
    b'\n' + message
)
commit_oid = write_object('commit', commit_data)

# Point HEAD and the branch at the initial commit.
with open(os.path.join(git_dir, 'HEAD'), 'wb') as f:
    f.write(b'ref: refs/heads/main\n')
with open(os.path.join(git_dir, 'refs', 'heads', 'main'), 'wb') as f:
    f.write(commit_oid.hex().encode() + b'\n')

# Minimal repository config.
with open(os.path.join(git_dir, 'config'), 'wb') as f:
    f.write(b'[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n')

# Build a v2 index so .gitignore is tracked and the working tree is clean.
st = os.stat('.gitignore')
path = b'.gitignore'
flags = len(path)  # low 12 bits: pathname length
entry = b''.join([
    struct.pack('>IIIIIIIIII', int(st.st_ctime) & 0xffffffff, st.st_ctime_ns % 1_000_000_000,
                int(st.st_mtime) & 0xffffffff, st.st_mtime_ns % 1_000_000_000,
                st.st_dev & 0xffffffff, st.st_ino & 0xffffffff,
                0o100644, st.st_uid & 0xffffffff, st.st_gid & 0xffffffff,
                st.st_size & 0xffffffff),
    blob_oid,
    struct.pack('>H', flags),
    path + b'\0',
])
entry += b'\0' * ((8 - len(entry) % 8) % 8)
index_body = b'DIRC' + struct.pack('>II', 2, 1) + entry
index_data = index_body + hashlib.sha1(index_body).digest()
with open(os.path.join(git_dir, 'index'), 'wb') as f:
    f.write(index_data)

print('Created repository with initial commit')
print('commit', commit_oid.hex())
print('tree  ', tree_oid.hex())
print('blob  ', blob_oid.hex())
