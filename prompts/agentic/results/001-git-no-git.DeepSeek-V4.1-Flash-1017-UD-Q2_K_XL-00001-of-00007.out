import hashlib, os, struct, zlib
from pathlib import Path

git = Path('.git')

def read_object(oid):
    p = git / 'objects' / oid[:2] / oid[2:]
    raw = zlib.decompress(p.read_bytes())
    assert hashlib.sha1(raw).hexdigest() == oid
    header, data = raw.split(b'\0', 1)
    kind, size = header.split(b' ')
    assert int(size) == len(data)
    return kind.decode(), data

head = (git / 'HEAD').read_text().strip()
assert head == 'ref: refs/heads/main'
commit_oid = (git / 'refs/heads/main').read_text().strip()
kind, commit = read_object(commit_oid)
assert kind == 'commit'
lines = commit.split(b'\n')
tree_line = next(l for l in lines if l.startswith(b'tree '))
tree_oid = tree_line[5:].decode()
kind, tree = read_object(tree_oid)
assert kind == 'tree'
entries = []
pos = 0
while pos < len(tree):
    space = tree.index(b' ', pos)
    nul = tree.index(b'\0', space)
    mode = tree[pos:space].decode()
    name = tree[space+1:nul].decode()
    oid = tree[nul+1:nul+21].hex()
    entries.append((mode, name, oid))
    pos = nul + 21
assert entries == [('100644', '.gitignore', '0d20b6487c61e7d1bde93acf4a14b7a89083a16d')], entries
kind, blob = read_object(entries[0][2])
assert kind == 'blob' and blob == b'*.pyc\n'

# Verify the index points at the same blob and has exactly one entry.
index = (git / 'index').read_bytes()
assert hashlib.sha1(index[:-20]).digest() == index[-20:]
assert index[:4] == b'DIRC' and struct.unpack('>I', index[4:8])[0] == 2
assert struct.unpack('>I', index[8:12])[0] == 1
assert index[12+40:12+60].hex() == entries[0][2]
assert index[12+62:12+62+9] == b'.gitignore'

# Exactly three objects (blob, tree, commit), and only the one branch ref.
objects = [p for p in (git / 'objects').glob('*/*')]
assert len(objects) == 3, objects
refs = [p for p in (git / 'refs').rglob('*') if p.is_file()]
assert refs == [git / 'refs' / 'heads' / 'main'], refs

print('Verification passed')
print('HEAD:', head)
print('Commit:', commit_oid)
print('Commit message:', commit.split(b'\n\n', 1)[1].decode().strip())
print('Tree entries:', entries)
print('Tracked files in index: 1 (.gitignore)')
