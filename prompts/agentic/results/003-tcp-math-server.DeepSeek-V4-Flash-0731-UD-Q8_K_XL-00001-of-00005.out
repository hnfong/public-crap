{"path": "/workspace/mathd.c", "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <arpa/inet.h>\n\n#define PORT 6767\n\ntypedef struct {\n    const char *s;\n    int pos;\n    int err;\n} Parser;\n\nstatic void skip_ws(Parser *p) {\n    while (p->s[p->pos] == ' ' || p->s[p->pos] == '\\t')\n        p->pos++;\n}\n\nstatic double expr(Parser *p);\n\nstatic double primary(Parser *p) {\n    skip_ws(p);\n    double val = 0;\n    if (p->s[p->pos] == '(') {\n        p->pos++;\n        val = expr(p);\n        skip_ws(p);\n        if (p->s[p->pos] == ')')\n            p->pos++;\n        else\n            p->err = 1;\n    } else if (p->s[p->pos] == '+' || p->s[p->pos] == '-') {\n        int neg = (p->s[p->pos] == '-');\n        p->pos++;\n        val = primary(p);\n        if (neg) val = -val;\n    } else if (p->s[p->pos] >= '0' && p->s[p->pos] <= '9') {\n        char *end;\n        val = strtod(p->s + p->pos, &end);\n        if (end == p->s + p->pos)\n            p->err = 1;\n        p->pos = (int)(end - p->s);\n    } else {\n        p->err = 1;\n    }\n    return val;\n}\n\nstatic double term(Parser *p) {\n    double v = primary(p);\n    for (;;) {\n        skip_ws(p);\n        if (p->s[p->pos] == '*') {\n            p->pos++;\n            v *= primary(p);\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\nstatic double expr(Parser *p) {\n    double v = term(p);\n    for (;;) {\n        skip_ws(p);\n        if (p->s[p->pos] == '+') {\n            p->pos++;\n            v += term(p);\n        } else if (p->s[p->pos] == '-') {\n            p->pos++;\n            v -= term(p);\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\nstatic double evaluate(const char *line) {\n    Parser p;\n    p.s = line;\n    p.pos = 0;\n    p.err = 0;\n    double val = expr(&p);\n    skip_ws(&p);\n    if (p.err || p.s[p.pos] != '\\0')\n        r