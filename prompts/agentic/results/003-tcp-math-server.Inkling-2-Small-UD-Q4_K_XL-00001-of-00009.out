{"content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <errno.h>\n#include <signal.h>\n#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <sys/wait.h>\n\n#define PORT 6767\n#define MAX_LINE 8192\n\n/* ---------- expression evaluator (recursive descent) ---------- */\n\ntypedef struct {\n    const char *s;\n    int pos;\n    int error;\n} Parser;\n\nstatic void skip_ws(Parser *p) {\n    while (p->s[p->pos] == ' ' || p->s[p->pos] == '\\t' ||\n           p->s[p->pos] == '\\r' || p->s[p->pos] == '\\n')\n        p->pos++;\n}\n\nstatic double parse_expr(Parser *p);\n\nstatic double parse_factor(Parser *p) {\n    skip_ws(p);\n    char c = p->s[p->pos];\n\n    if (c == '-') { /* unary minus */\n        p->pos++;\n        return -parse_factor(p);\n    }\n    if (c == '+') { /* unary plus */\n        p->pos++;\n        return parse_factor(p);\n    }\n    if (c == '(') {\n        p->pos++;\n        double v = parse_expr(p);\n        skip_ws(p);\n        if (p->s[p->pos] != ')') {\n            p->error = 1;\n            return 0.0;\n        }\n        p->pos++;\n        return v;\n    }\n    if ((c >= '0' && c <= '9') || c == '.') {\n        char *end;\n        double v = strtod(p->s + p->pos, &end);\n        if (end == p->s + p->pos) {\n            p->error = 1;\n            return 0.0;\n        }\n        p->pos = (int)(end - p->s);\n        return v;\n    }\n    p->error = 1;\n    return 0.0;\n}\n\nstatic double parse_term(Parser *p) {\n    double v = parse_factor(p);\n    for (;;) {\n        skip_ws(p);\n        if (p->s[p->pos] == '*') {\n            p->pos++;\n            v *= parse_factor(p);\n        } else {\n            break;\n        }\n        if (p->error) return 0.0;\n    }\n    return v;\n}\n\nstatic double parse_expr(Parser *p) {\n    double v = parse_term(p);\n    for (;;) {\n        skip_ws(p);\n        char c = p->s[p->pos];\n        if (c == '+') {\n            p->pos++;\n            v += parse_term(p);\n        } else if (c == '-') {\n            p->pos++;\n            v -= parse_term(p);\n        } else {\n            break;\n        }\n        if (p->error) return 0.0;\n    }\n    return v;\n}\n\n/* Returns 1 on success and stores result in *out, 0 on invalid input. */\nstatic int evaluate(const char *line, double *out) {\n    Parser p;\n    p.s = line;\n    p.pos = 0;\n    p.error = 0;\n\n    skip_ws(&p);\n    if (p.s[p.pos] == '\\0') return 0; /* empty expression */\n\n    double v = parse_expr(&p);\n    skip_ws(&p);\n    if (p.error) return 0;\n    if (p.s[p.pos] != '\\0') return 0; /* trailing garbage */\n\n    *out = v;\n    return 1;\n}\n\n/* ---------- TCP server ---------- */\n\nstatic void handle_client(int fd) {\n    char buf[MAX_LINE];\n    size_t used = 0;\n    int got_line = 0;\n\n    /* Read until first newline (or EOF / buffer full). */\n    while (used < sizeof(buf) - 1) {\n        char ch;\n        ssize_t n = read(fd, &ch, 1);\n        if (n <= 0) break;\n        if (ch == '\\n') { got_line = 1; break; }\n        buf[used++] = ch;\n    }\n    buf[used] = '\\0';\n\n    char resp[128];\n    double result;\n    if (!got_line && used == 0) {\n        /* connection closed without sending anything */\n        close(fd);\n        return;\n    }\n    if (used >= sizeof(buf) - 1) {\n        /* line too long: treat as invalid */\n        snprintf(resp, sizeof(resp), \"NaN\\n\");\n    } else if (evaluate(buf, &result)) {\n        /* Print integral values without a decimal point. */\n        if (result == (double)(long long)result &&\n            result >= -9.2233720368547758e18 && result <= 9.2233720368547758e18) {\n            snprintf(resp, sizeof(resp), \"%lld\\n\", (long long)result);\n        } else {\n            snprintf(resp, sizeof(resp), \"%g\\n\", result);\n        }\n    } else {\n        snprintf(resp, sizeof(resp), \"NaN\\n\");\n    }\n\n    size_t len = strlen(resp);\n    size_t off = 0;\n    while (off < len) {\n        ssize_t n = write(fd, resp + off, len - off);\n        if (n <= 0) break;\n        off += (size_t)n;\n    }\n    close(fd);\n}\n\nstatic void sigchld_handler(int sig) {\n    (void)sig;\n    while (waitpid(-1, NULL, WNOHANG) > 0)\n        ;\n}\n\nint main(void) {\n    int listen_fd = socket(AF_INET, SOCK_STREAM, 0);\n    if (listen_fd < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n\n    int opt = 1;\n    setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));\n\n    struct sockaddr_in addr;\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n    addr.sin_port = htons(PORT);\n\n    if (bind(listen_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {\n        perror(\"bind\");\n        return 1;\n    }\n    if (listen(listen_fd, 16) < 0) {\n        perror(\"listen\");\n        return 1;\n    }\n\n    struct sigaction sa;\n    memset(&sa, 0, sizeof(sa));\n    sa.sa_handler = sigchld_handler;\n    sigaction(SIGCHLD, &sa, NULL);\n\n    for (;;) {\n        int client_fd = accept(listen_fd, NULL, NULL);\n        if (client_fd < 0) {\n            if (errno == EINTR) continue;\n            perror(\"accept\");\n            continue;\n        }\n        pid_t pid = fork();\n        if (pid < 0) {\n            perror(\"fork\");\n            close(client_fd);\n            continue;\n        }\n        if (pid == 0) {\n            close(listen_fd);\n            handle_client(client_fd);\n            _exit(0);\n        }\n        close(client_fd);\n    }\n\n    return 0;\n}\n", "path": "/workspace/mathd.c"}
