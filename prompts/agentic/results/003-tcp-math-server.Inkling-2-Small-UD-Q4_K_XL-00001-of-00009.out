import socket

def query(expr):
    s = socket.create_connection(('127.0.0.1', 6767), timeout=2)
    s.sendall(expr.encode() + b'\n')
    data = b''
    while b'\n' not in data:
        chunk = s.recv(1024)
        if not chunk: break
        data += chunk
    s.close()
    return data.decode().strip()

tests = ['2+4', '(2+3)*4', '2*(3+(4*5))', '10-20', '3*3*3', '((((1+1))))', '5*-3', '1/2', '2+', '*3', '()', '(())', '2 + 3 * 4 - 10', '999999999*999999999', '3.5+2.25']
for t in tests:
    print(repr(t), '=>', query(t))
EOF
