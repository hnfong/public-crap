[tool call: bash]
$ cd /workspace && python3 - <<'EOF'
import hashlib, os, zlib

def store(kind: bytes, payload: bytes) -> bytes:
    return b"%b %d\x00" % (kind, len(payload)) + payload

def git_hash(s: bytes) -> bytes:
    return hashlib.sha1(s).digest()

def write_obj(kind: bytes, payload: bytes):
    s = store(kind, payload)
    h = git_hash(s)
    p = ".git/objects/%s/%s" % (h.hex()[:2], h.hex()[2:])
    os.makedirs(os.path.dirname(p), exist_ok=True)
    open(p, "wb").write(zlib.compress(s))
    return h.hex()

content = open(".gitignore", "rb").read()
assert content == b"*.pyc\n"

blob = write_obj(b"blob", content)
tree_entry = b"100644 blob .gitignore\x00" + bytes.fromhex(blob)
tree = write_obj(b"tree", tree_entry)

ident = "Gitless Gopher <gopher@nogi.th>"
import time
now = int(time.time())
commit_payload = (
    "tree " + tree + "\n"
    "author %s %d +0000\n"
    "committer %s %d +0000\n"
    "\n"
    "Why do programmers prefer dark mode? Because light attracts bugs!\n"
    % (ident, now, ident, now)
).encode()
commit = write_obj(b"commit", commit_payload)

open(".git/refs/heads/main", "w").write(commit + "\n")
print("blob  :", blob)
print("tree  :", tree)
print("commit:", commit)
EOF
