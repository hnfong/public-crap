import hashlib, os, time, zlib

GIT_DIR = ".git"
BRANCH = "main"

def git_hash(kind, data: bytes) -> bytes:
    store = b"%b %d\x00" % (kind, len(data)) + data
    return hashlib.sha1(store).digest()

def write_obj(data: bytes, h: bytes):
    d = GIT_DIR + "/objects/" + h.hex()[:2]
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, h.hex()[2:]), "wb") as f:
        f.write(zlib.compress(data))
    return h.hex()

# 1. .gitignore in the working tree
content = b"*.pyc\n"
open(".gitignore", "wb").write(content)

# 2. Repo skeleton
for sub in ("objects", "refs/heads", "refs/tags"):
    os.makedirs(os.path.join(GIT_DIR, sub), exist_ok=True)
open(os.path.join(GIT_DIR, "HEAD"), "w").write("ref: refs/heads/%s\n" % BRANCH)
open(os.path.join(GIT_DIR, "config"), "w").write(
    "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n"
)

# 3. Objects
blob = git_hash("blob", content)
tree_entry = b"100644 blob .gitignore\x00" + blob
tree = git_hash("tree", tree_entry)

now = int(time.time())
ident = "Gitless Gopher <gopher@nogi.th>"
commit = (
    "tree " + tree.hex() + "\n"
    "author %s %d +0000\n"
    "committer %s %d +0000\n"
    "\n"
    "Why do programmers prefer dark mode? Because light attracts bugs!\n"
    % (ident, now, ident, now)
).encode()
commit_hash = git_hash("commit", commit)

# 4. Loose objects + ref
for data, h in ((content, blob), (tree_entry, tree), (commit, commit_hash)):
    write_obj(data, h)
open(os.path.join(GIT_DIR, "refs", "heads", BRANCH), "w").write(commit_hash.hex() + "\n")

print("commit:", commit_hash.hex())
EOF
