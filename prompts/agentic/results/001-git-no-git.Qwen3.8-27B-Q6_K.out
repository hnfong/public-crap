Found a real bug: git's tree entry format is `<mode> <name>\0<sha>`, with **no** object type — I was mistakenly including `"blob "` in the entry, which was making the filename `blob .gitignore`. Rebuilding the tree and commit correctly:
[tool call: bash]
$ cd /workspace && rm -rf .git/objects/8d .git/objects/22 && python3 - <<'EOF'
import hashlib, os, time, zlib

def write_obj(kind: bytes, payload: bytes) -> str:
    s = b"%b %d\x00" % (kind, len(payload)) + payload
    h = hashlib.sha1(s).hexdigest()
    p = ".git/objects/%s/%s" % (h[:2], h[2:])
    os.makedirs(os.path.dirname(p), exist_ok=True)
    open(p, "wb").write(zlib.compress(s))
    return h

blob = "0d20b6487c61e7d1bde93acf4a14b7a89083a16d"  # b"*.pyc\n" (already on disk, verified)

# tree entry: "<mode> <name>\0<20-byte blob sha>"  — no object type!
tree = write_obj(b"tree", b"100644 .gitignore\x00" + bytes.fromhex(blob))

ident = "Gitless Gopher <gopher@nogi.th>"
now = int(time.time())
commit = write_obj(b"commit", (
    "tree " + tree + "\n"
    "author %s %d +0000\n"
    "committer %s %d +0000\n"
    "\n"
    "Why do programmers prefer dark mode? Because light attracts bugs!\n"
    % (ident, now, ident, now)
).encode())

open(".git/refs/heads/main", "w").write(commit + "\n")
print("tree  :", tree)
print("commit:", commit)
EOF
