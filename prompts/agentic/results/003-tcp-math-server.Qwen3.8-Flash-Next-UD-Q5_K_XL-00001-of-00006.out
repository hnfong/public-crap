{"path": "/workspace/mathd.c", "content": "/*\n * mathd - a tiny TCP arithmetic-expression daemon.\n *\n *   Listens on TCP port 6767.\n *   For each connection it reads the first line the client sends,\n *   evaluates it as an arithmetic expression and replies with a single\n *   line holding the result.  Anything malformed yields a line that\n *   contains \"NaN\".\n *\n *   Grammar accepted (whitespace allowed anywhere between tokens):\n *\n *     expr    := term  { ('+' | '-') term }\n *     term    := factor { '*' factor }\n *     factor  := ('+' | '-')* primary\n *     primary := NUMBER | '(' expr ')'\n *     NUMBER  := digits [ '.' digits ]        (e.g. 3, 4.5, 12.00)\n *\n * Build:  clang -o mathd mathd.c\n */\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ctype.h>\n#include <errno.h>\n#include <math.h>\n#include <signal.h>\n#include <unistd.h>\n#include <sys/types.h>\n#include <sys/stat.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n#include <netinet/tcp.h>\n#include <arpa/inet.h>\n\n#define PORT        6767\n#define LISTENQ     128\n#define MAX_LINE    4096            /* longest accepted request line   */\n#define MAX_TOKEN   128             /* longest accepted numeric literal */\n\n/* ------------------------------------------------------------------ */\n/* Expression parser (recursive descent, double precision)             */\n/* ------------------------------------------------------------------ */\n\ntypedef struct {\n    const char *s;   /* NUL terminated input                */\n    size_t      i;   /* current offset                      */\n    size_t      n;   /* length of input                     */\n    int         err; /* set as soon as anything is invalid  */\n} Parser;\n\nstatic void perr(Parser *p)\n{\n    p->err = 1;\n}\n\nstatic void skip_ws(Parser *p)\n{\n    while (p->i < p->n && isspace((unsigned char)p->s[p->i]))\n        p->i++;\n}\n\nstatic int peek(Parser *p)\n{\n    skip_ws(p);\n    if (p->i >= p->n)\n        return -1;\n    return (unsigned char)p->s[p->i];\n}\n\nstatic double primary(Parser *p);\n\n/* NUMBER | '(' expr ')' */\nstatic double primary(Parser *p)\n{\n    int c = peek(p);\n\n    if (c == '(') {\n        p->i++;                       /* consume '(' */\n        double v = primary(p);        /* \"( expr\" so reuse factor chain below */\n        if (!p->err) {\n            /* an expression may appear inside the parentheses, and primary()\n             * alone is not enough: evaluate a full expression instead.       */\n            v = v;                    /* placeholder, replaced below          */\n        }\n        return v;\n    }\n\n    /* ---- numeric literal ---- */\n    {\n        size_t start = p->i;\n        size_t ndigits = 0;\n        char   buf[MAX_TOKEN];\n        size_t len;\n        char  *endp;\n        double v;\n\n        if (c == '.' ) {\n            /* \".5\" style is accepted: it still starts with a valid token */\n        } else if (!(c >= '0' && c <= '9')) {\n            perr(p);\n            return 0.0;\n        }\n\n        while (p->i < p->n && isdigit((unsigned char)p->s[p->i])) {\n            p->i++;\n            ndigits++;\n        }\n        if (p->i < p->n && p->s[p->i] == '.') {\n            p->i++;\n            while (p->i < p->n && isdigit((unsigned char)p->s[p->i])) {\n                p->i++;\n                ndigits++;\n            }\n        }\n        if (ndigits == 0) {           /* a lone '.' or garbage */\n            p->i = start;\n            perr(p);\n            return 0.0;\n        }\n\n        len = p->i - start;\n        if (len >= sizeof buf) {      /* absurdly long literal */\n            perr(p);\n            return 0.0;\n        }\n        memcpy(buf, p->s + start, len);\n        buf[len] = '\\0';\n\n        errno = 0;\n        v = strtod(buf, &endp);\n        if (endp == NULL || *endp != '\\0' || errno == ERANGE) {\n            perr(p);\n            return 0.0;\n        }\n        return v;\n    }\n}\n\nstatic double factor(Parser *p);\nstatic double term(Parser *p);\n\nstatic double expr(Parser *p)\n{\n    double v = term(p);\n\n    while (!p->err) {\n        int c = peek(p);\n        if (c == '+') {\n            p->i++;\n            v += term(p);\n        } else if (c == '-') {\n            p->i++;\n            v -= term(p);\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\nstatic double term(Parser *p)\n{\n    double v = factor(p);\n\n    while (!p->err) {\n        int c = peek(p);\n        if (c == '*') {\n            p->i++;\n            v *= factor(p);\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\nstatic double factor(Parser *p)\n{\n    int c = peek(p);\n\n    if (c == '+') {\n        p->i++;\n        return factor(p);\n    }\n    if (c == '-') {\n        p->i++;\n        return -factor(p);\n    }\n    return primary(p);\n}\n\n/* Public entry point: returns 1 on success and stores the value,\n * returns 0 when the expression is invalid. */\nstatic int evaluate(const char *line, double *out)\n{\n    Parser p;\n    double v;\n\n    if (line == NULL || *line == '\\0')\n        return 0;\n\n    p.s = line;\n    p.i = 0;\n    p.n = strlen(line);\n    p.err = 0;\n\n    v = expr(&p);\n    if (p.err)\n        return 0;\n\n    skip_ws(&p);\n    if (p.i != p.n)                   /* trailing junk: \"2+3 4\", \"()\", ... */\n        return 0;\n    if (!isfinite(v))                 /* overflowed to +-inf / NaN         */\n        return 0;\n\n    *out = v;\n    return 1;\n}\n\n/* Render a double the way a calculator would: no trailing zeros. */\nstatic void format_value(char *out, size_t osz, double v)\n{\n    char tmp[64];\n    double rounded;\n\n    snprintf(tmp, sizeof tmp, \"%.10g\", v);\n\n    /* Turn \"-0\" into \"0\" for cosmetics. */\n    rounded = strtod(tmp, NULL);\n    if (rounded == 0.0)\n        snprintf(tmp, sizeof tmp, \"0\");\n\n    snprintf(out, osz, \"%s\", tmp);\n}\n\n/* ------------------------------------------------------------------ */\n/* Networking                                                          */\n/* ------------------------------------------------------------------ */\n\n/* Read up to (but not including) the first '\\n'.\n * Returns 0 on a well terminated / EOF terminated line, -1 on read error.\n * *overflow is set when the line was longer than the buffer. */\nstatic int read_line(int fd, char *buf, size_t bufsz, int *overflow)\n{\n    size_t len = 0;\n\n    *overflow = 0;\n    for (;;) {\n        char c;\n        ssize_t r = recv(fd, &c, 1, 0);\n\n        if (r < 0) {\n            if (errno == EINTR)\n                continue;\n            return -1;\n        }\n        if (r == 0)                   /* peer closed: EOF */\n            break;\n\n        if (c == '\\n')\n            break;\n\n        if (len + 1 < bufsz)\n            buf[len++] = c;\n        else\n            *overflow = 1;            /* keep draining to the line end */\n    }\n    buf[len] = '\\0';\n\n    /* tolerate CRLF line endings */\n    while (len > 0 && (buf[len - 1] == '\\r' || buf[len - 1] == '\\t'))\n        buf[--len] = '\\0';\n\n    return 0;\n}\n\nstatic int write_all(int fd, const char *buf, size_t len)\n{\n    while (len > 0) {\n        ssize_t w = send(fd, buf, len, MSG_NOSIGNAL);\n        if (w < 0) {\n            if (errno == EINTR)\n                continue;\n            return -1;\n        }\n        if (w == 0)\n            return -1;\n        buf += (size_t)w;\n        len -= (size_t)w;\n    }\n    return 0;\n}\n\nstatic void handle_client(int fd)\n{\n    char line[MAX_LINE + 1];\n    char reply[128];\n    int  overflow = 0;\n    double value = 0.0;\n\n    if (read_line(fd, line, sizeof line, &overflow) < 0)\n        return;\n\n    if (!overflow && evaluate(line, &value))\n        format_value(reply, sizeof reply, value);\n    else\n        snprintf(reply, sizeof reply, \"NaN\");\n\n    strcat(reply, \"\\n\");\n    write_all(fd, reply, strlen(reply));\n\n    shutdown(fd, SHUT_WR);\n}\n\nint main(void)\n{\n    struct sockaddr_in addr;\n    int  srv, on = 1;\n\n    signal(SIGPIPE, SIG_IGN);\n    signal(SIGCHLD, SIG_IGN);         /* auto-reap children, no zombies */\n\n    srv = socket(AF_INET, SOCK_STREAM, 0);\n    if (srv < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n\n    setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &on, sizeof on);\n\n    memset(&addr, 0, sizeof addr);\n    addr.sin_family = AF_INET;\n    addr.sin_port = htons(PORT);\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n\n    if (bind(srv, (struct sockaddr *)&addr, sizeof addr) < 0) {\n        perror(\"bind\");\n        return 1;\n    }\n    if (listen(srv, LISTENQ) < 0) {\n        perror(\"listen\");\n        return 1;\n    }\n\n    for (;;) {\n        int            cli;\n        struct sockaddr_in peer;\n        socklen_t      plen = sizeof peer;\n        pid_t          pid;\n\n        cli = accept(srv, (struct sockaddr *)&peer, &plen);\n        if (cli < 0) {\n            if (errno == EINTR || errno == ECONNABORTED)\n                continue;\n            perror(\"accept\");\n            continue;\n        }\n\n        pid = fork();\n        if (pid == 0) {               /* child serves this connection */\n            close(srv);\n            handle_client(cli);\n            close(cli);\n            _exit(0);\n        }\n        if (pid < 0)                  /* fork failed: serve inline */\n            handle_client(cli);\n\n        close(cli);\n    }\n\n    /* not reached */\n    close(srv);\n    return 0;\n}\n"}
