{"content": "#!/usr/bin/env python3\nimport socket, subprocess, time, sys, os, signal\n\nCASES = [\n    # (expression sent, expected reply)\n    (\"2+4\",            \"6\"),\n    (\"2-4\",            \"-2\"),\n    (\"3*4\",            \"12\"),\n    (\" 2 + 4 \",        \"6\"),\n    (\"2+3*4\",          \"14\"),           # precedence\n    (\"(2+3)*4\",        \"20\"),\n    (\"2*(3+4)\",        \"14\"),\n    (\"((2+3))\",        \"5\"),\n    (\"(((1+2)*(3+4)))\",\"21\"),           # nested parens\n    (\"(1+2)*(3-(4-5))\",\"9\"),\n    (\"2*(3+(4*(5-3)))\",\"22\"),\n    (\"-3+5\",           \"2\"),            # unary minus\n    (\"-(2+3)\",         \"-5\"),\n    (\"+-7\",            \"-7\"),\n    (\"1.5*2\",          \"3\"),\n    (\"0.1+0.2\",        \"0.3\"),\n    (\"10/2\",           \"NaN\"),          # division not supported\n    (\"2 3\",            \"NaN\"),\n    (\"\",               \"NaN\"),\n    (\"()\",             \"NaN\"),\n    (\"(2+3\",           \"NaN\"),\n    (\"2+3)\",           \"NaN\"),\n    (\"2++\",            \"NaN\"),\n    (\"2+*3\",           \"NaN\"),\n    (\"abc\",            \"NaN\"),\n    (\"2+3 4\",          \"NaN\"),\n    (\"(1+2))\",         \"NaN\"),\n    (\"*-2\",            \"NaN\"),\n    (\"1e5\",            \"NaN\"),          # exponent notation rejected\n    (\"2**3\",           \"NaN\"),\n    (\"999999999999999999999999*999999999999999999999999\", \"NaN\"),  # overflow\n]\n\ndef query(expr, port=6767, timeout=3.0):\n    with socket.create_connection((\"127.0.0.1\", port), timeout=timeout) as s:\n        s.sendall((expr + \"\\n\").encode())\n        s.shutdown(socket.SHUT_WR)\n        data = b\"\"\n        while True:\n            chunk = s.recv(4096)\n            if not chunk:\n                break\n            data += chunk\n    lines = data.decode().splitlines()\n    return lines[0] if lines else \"<no reply>\"\n\ndef main():\n    fails = 0\n    for expr, want in CASES:\n        try:\n            got = query(expr)\n        except Exception as e:\n            got = \"ERR:%s\" % e\n        ok = (got == want)\n        if not ok:\n            fails += 1\n        print(\"%-4s %-52r -> %-10r (want %r)\" % (\"ok\" if ok else \"FAIL\", expr, got, want))\n\n    # no trailing newline at all (client closes instead)\n    with socket.create_connection((\"127.0.0.1\", 6767), timeout=3) as s:\n        s.sendall(b\"5*(2+3)\")\n        s.shutdown(socket.SHUT_WR)\n        got = s.recv(4096).decode().strip()\n    print(\"%-4s %-52r -> %-10r (want %r)\" % (\"ok\" if got == \"25\" else \"FAIL\",\n          \"5*(2+3) [no newline]\", got, \"25\"))\n    if got != \"25\":\n        fails += 1\n\n    # first line only is used; concurrent connections\n    conns = [socket.create_connection((\"127.0.0.1\", 6767), timeout=5) for _ in range(5)]\n    for i, c in enumerate(conns):\n        c.sendall((\"%d*%d\\n\" % (i + 1, i + 1)).encode())\n    results = []\n    for c in conns:\n        results.append(c.recv(4096).decode().strip())\n        c.close()\n    want = [str((i + 1) * (i + 1)) for i in range(5)]\n    ok = results == want\n    print(\"%-4s concurrent 5x -> %r (want %r)\" % (\"ok\" if ok else \"FAIL\", results, want))\n    if not ok:\n        fails += 1\n\n    # oversized line must still answer NaN\n    with socket.create_connection((\"127.0.0.1\", 6767), timeout=5) as s:\n        s.sendall((b\"1+\" * 6000) + b\"\\n\")\n        s.shutdown(socket.SHUT_WR)\n        got = s.recv(4096).decode().strip()\n    print(\"%-4s %-52r -> %-10r (want %r)\" % (\"ok\" if got == \"NaN\" else \"FAIL\",\n          \"huge line\", got, \"NaN\"))\n    if got != \"NaN\":\n        fails += 1\n\n    print(\"\\n%d failures\" % fails)\n    return 1 if fails else 0\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n", "path": "/workspace/test_mathd.py"}
