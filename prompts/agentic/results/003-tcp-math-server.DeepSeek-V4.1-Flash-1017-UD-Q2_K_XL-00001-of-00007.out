{"path": "/workspace/mathd.c", "content": "#include <arpa/inet.h>\n#include <ctype.h>\n#include <netinet/in.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/socket.h>\n#include <sys/types.h>\n#include <unistd.h>\n\n/*\n * Simple recursive-descent parser for integer arithmetic with\n * +, -, * and parentheses.  On any syntax error the `err` flag is set\n * and evaluation stops; the caller reports NaN.\n *\n *   expr   := term (('+' | '-') term)*\n *   term   := factor ('*' factor)*\n *   factor := '-' factor | number | '(' expr ')'\n */\n\nstruct parser {\n    const char *s;\n    int err;\n};\n\nstatic void skip_ws(struct parser *p)\n{\n    while (*p->s && isspace((unsigned char)*p->s))\n        p->s++;\n}\n\nstatic long parse_expr(struct parser *p);\n\nstatic long parse_number(struct parser *p)\n{\n    long v = 0;\n\n    skip_ws(p);\n    if (!isdigit((unsigned char)*p->s)) {\n        p->err = 1;\n        return 0;\n    }\n    while (isdigit((unsigned char)*p->s)) {\n        /* Overflow guard: bail out instead of wrapping around. */\n        if (v > (LONG_MAX - (*p->s - '0')) / 10) {\n            p->err = 1;\n            return 0;\n        }\n        v = v * 10 + (*p->s - '0');\n        p->s++;\n    }\n    return v;\n}\n\nstatic long parse_factor(struct parser *p)\n{\n    long v;\n\n    skip_ws(p);\n    if (*p->s == '-') {\n        p->s++;\n        v = parse_factor(p);\n        return p->err ? 0 : -v;\n    }\n    if (*p->s == '+') {\n        p->s++;\n        return parse_factor(p);\n    }\n    if (*p->s == '(') {\n        p->s++;\n        v = parse_expr(p);\n        if (p->err)\n            return 0;\n        skip_ws(p);\n        if (*p->s != ')') {\n            p->err = 1;\n            return 0;\n        }\n        p->s++;\n        return v;\n    }\n    return parse_number(p);\n}\n\nstatic long parse_term(struct parser *p)\n{\n    long v = parse_factor(p);\n\n    while (!p->err) {\n        skip_ws(p);\n        if (*p->s == '*') {\n            p->s++;\n            v *= parse_factor(p);\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\nstatic long parse_expr(struct parser *p)\n{\n    long v = parse_term(p);\n\n    while (!p->err) {\n        skip_ws(p);\n        if (*p->s == '+') {\n            p->s++;\n            v += parse_term(p);\n        } else if (*p->s == '-') {\n            p->s++;\n            v -= parse_term(p);\n        } else {\n            break;\n        }\n    }\n    return v;\n}\n\n/* Returns 1 and stores the result in *out on success, 0 on failure. */\nstatic int evaluate(const char *input, long *out)\n{\n    struct parser p = { input, 0 };\n    long v;\n\n    v = parse_expr(&p);\n    if (p.err)\n        return 0;\n    skip_ws(&p);\n    if (*p.s != '\\0') /* trailing garbage */\n        return 0;\n    *out = v;\n    return 1;\n}\n\n/* Write the whole buffer, retrying on short writes / EINTR. */\nstatic int send_all(int fd, const char *buf, size_t len)\n{\n    while (len > 0) {\n        ssize_t n = write(fd, buf, len);\n        if (n < 0)\n            return -1;\n        buf += n;\n        len -= (size_t)n;\n    }\n    return 0;\n}\n\nstatic void handle_client(int fd)\n{\n    char line[4096];\n    size_t used = 0;\n    int eof = 0;\n\n    /* Read until newline, EOF, or buffer full. */\n    while (used < sizeof(line) - 1) {\n        char c;\n        ssize_t n = read(fd, &c, 1);\n        if (n <= 0) {\n            eof = 1;\n            break;\n        }\n        if (c == '\\n')\n            break;\n        if (c == '\\r')\n            continue;\n        line[used++] = c;\n    }\n    line[used] = '\\0';\n\n    char out[64];\n    long value;\n\n    if (used == 0 && eof) {\n        /* Connection closed without sending anything: nothing to do. */\n        return;\n    }\n\n    if (evaluate(line, &value))\n        snprintf(out, sizeof(out), \"%ld\\n\", value);\n    else\n        snprintf(out, sizeof(out), \"NaN\\n\");\n\n    send_all(fd, out, strlen(out));\n}\n\nint main(void)\n{\n    int srv, one = 1;\n    struct sockaddr_in addr;\n\n    srv = socket(AF_INET, SOCK_STREAM, 0);\n    if (srv < 0) {\n        perror(\"socket\");\n        return 1;\n    }\n    setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));\n\n    memset(&addr, 0, sizeof(addr));\n    addr.sin_family = AF_INET;\n    addr.sin_addr.s_addr = htonl(INADDR_ANY);\n    addr.sin_port = htons(6767);\n\n    if (bind(srv, (struct sockaddr *)&addr, sizeof(addr)) < 0) {\n        perror(\"bind\");\n        close(srv);\n        return 1;\n    }\n    if (listen(srv, 64) < 0) {\n        perror(\"listen\");\n        close(srv);\n        return 1;\n    }\n\n    for (;;) {\n        int cfd = accept(srv, NULL, NULL);\n        if (cfd < 0)\n            continue;\n        handle_client(cfd);\n        close(cfd);\n    }\n}\n"}
