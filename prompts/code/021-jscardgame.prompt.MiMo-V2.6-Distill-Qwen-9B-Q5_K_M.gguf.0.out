<!DOCTYPE html><html><head><meta charset=utf-8><title>Neon Solitaire</title><style>
*{box-sizing:border-box}html,body{margin:0;height:100%;background:#05070f;overflow:hidden;font:12px/1.2 monospace;color:#dff}
#app{display:flex;flex-direction:column;height:100%;padding:8px;gap:6px}
#top{display:flex;justify-content:space-between;align-items:center;color:#7ef}
#top b{color:#fff}
#board{flex:1;min-height:0;display:flex;flex-direction:column;gap:6px}
#deck{display:flex;justify-content:center;align-items:center;gap:10px}
#table{flex:1;min-height:0;display:flex;gap:10px;align-items:flex-start}
#founds{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.col{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:4px}
.hint{color:#7ef;opacity:.75;text-align:center}
#msg{color:#ff6b6b;text-align:center;min-height:14px}
.card{position:relative;width:64px;height:88px;border-radius:6px;background:#12182b;border:1px solid #2a3550;box-shadow:0 3px 0 #000;user-select:none;cursor:default}
.card .s{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:26px;font-weight:bold}
.card .n{position:absolute;bottom:2px;left:3px;font-size:10px}
.card .b{position:absolute;right:3px;top:2px;font-size:10px}
.card.red .s,.card.red .b{color:#ff5f7e}.card.red .n{color:#ff5f7e}
.card.dark .s,.card.dark .b{color:#7ef}.card.dark .n{color:#7ef}
.card.face{background:#1b2440;border-color:#33406a}
.card.face .s{font-size:34px;opacity:.9}
.card.face .n,.card.face .b{color:#7ef}
.card.face .b{color:#7ef}
.card.face .n{color:#7ef}
.card.face .s{color:#fff}
.card.face .s.red{color:#ff5f7e}
.card.face .s.dark{color:#7ef}
.card.face .s{font-size:34px}
