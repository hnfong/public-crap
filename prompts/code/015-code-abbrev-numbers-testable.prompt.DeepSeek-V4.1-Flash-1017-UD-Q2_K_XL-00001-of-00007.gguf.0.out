Here's a Python function that abbreviates numbers into compact human-readable form:

```python
def abbrev_num(x):
    if x < 1000:
        return str(x)
    
    units = ['K', 'M', 'B', 'T']
    magnitude = 0
    value = float(x)
    
    while value >= 1000 and magnitude < len(units):
        value /= 1000
        magnitude += 1
    
    if magnitude == 0:
        return str(x)
    
    unit = units[magnitude - 1]
    
    # Try to fit within 4 characters
    # First try with one decimal place
    rounded = round(value, 1)
    if rounded == int(rounded):
        candidate = f"{int(rounded)}{unit}"
    else:
        candidate = f"{rounded}{unit}"
    
    if len(candidate) <= 4:
        return candidate
    
    # Try with no decimal places
    rounded = round(value)
    candidate = f"{int(rounded)}{unit}"
    
    if len(candidate) <= 4:
        return candidate
    
    # If still too long, just use the integer part
    return f"{int(value)}{unit}"
``` [end of text]


