Let's implement simple.

<|start|>assistant to=user<|message|>```python
def abbrev_num(x):
    if x < 0:
        sign = "-"
        x = -x
    else:
        sign = ""
    suffixes = [(1, ""), (1_000, "K"), (1_000_000, "M"), (1_000_000_000, "B"), (1_000_000_000_000, "T")]
    
    for factor, suf in suffixes:
        v = x / factor
        if v >= 1000 and suf != "":
            continue
        # try most precise first
        for dec in (1, 0):
            if dec == 1:
                # one decimal place, round half away from zero
                rounded = int(v * 10 + 0.5) / 10 if v >= 0 else int(v * 10 - 0.5) / 10
                if rounded == int(rounded):
                    s = str(int(rounded))
                else:
                    s = f"{rounded:.1f}"
            else:
                rounded = int(v + 0.5) if v >= 0 else int(v - 0.5)
                s = str(rounded)
            out = sign + s + suf
            if len(out) <= 4:
                # avoid leading zero like 0K
                if suf and int(s) == 0:
                    continue
                return out
    # fallback, no suffix fits
    return sign + str(x)
