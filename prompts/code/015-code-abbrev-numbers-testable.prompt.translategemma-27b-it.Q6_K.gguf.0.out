```python
def abbrev_num(x):
    """
    Abbreviates a number into a compact, human-readable string.

    Args:
        x: An integer.

    Returns:
        A string representing the number in a compact form (<= 4 characters).
    """
    if x < 1000:
        return str(x)
    elif x < 1000000:
        return f"{round(x / 1000, 1):.1f}K" if len(f"{round(x / 1000, 1):.1f}K") <= 4 else f"{round(x / 1000):.0f}K"
    elif x < 1000000000:
        return f"{round(x / 1000000, 1):.1f}M" if len(f"{round(x / 1000000, 1):.1f}M") <= 4 else f"{round(x / 1000000):.0f}M"
    else:
        return f"{round(x / 1000000000, 1):.1f}G" if len(f"{round(x / 1000000000, 1):.1f}G") <= 4 else f"{round(x / 1000000000):.0f}G"
