```html
<!DOCTYPE html><html>
<head><title>Poker</title>
<style>
body { font-family: sans-serif; }
.card { border: 1px solid black; padding: 5px; margin: 2px; display: inline-block; }
#player-hand, #dealer-hand { margin-top: 20px; }
</style>
</head><body>
<h1>Poker</h1>
<div id="player-hand"></div>
<div id="dealer-hand"></div>
<button onclick="play()">Deal</button>
<div id="result"></div>

<script>
const suits = ['C', 'D', 'H', 'S'];
const ranks = ['2', '3', '4', '5', '6', '7', '8', '9', 'T', 'J', 'Q', 'K', 'A'];
let deck = [];
let playerHand = [];
let dealerHand = [];

function createDeck() {
  deck = [];
  for (let suit of suits) {
    for (let rank of ranks) {
      deck.push({ suit, rank });
    }
  }
}

function shuffleDeck() {
  for (let i = deck.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [deck[i], deck[j]] = [deck[j], deck[i]];
  }
}

function dealCard() {
  return deck.pop();
}

function displayHand(hand, elementId) {
  let element = document.getElementById(elementId);
  element.innerHTML = '';
  for (let card of hand) {
    let cardElement = document.createElement('div');
    cardElement.className = 'card';
    cardElement.textContent = card.rank + card.suit;
    element.appendChild(cardElement);
  }
}

function play() {
  createDeck();
  shuffleDeck();
  playerHand = [];
  dealerHand = [];

  for (let i = 0; i < 2; i++) {
    playerHand.push(dealCard());
    dealerHand.push(dealCard());
  }

  displayHand(playerHand, 'player-hand');
  displayHand(dealerHand, 'dealer-hand');

  let playerScore = evaluateHand(playerHand);
  let dealerScore = evaluateHand(dealerHand);

  let resultElement = document.getElementById('result');
  if (playerScore > dealerScore) {
    resultElement.textContent = 'You win!';
  } else if (dealerScore > playerScore) {
    resultElement.textContent = 'You lose!';
  } else {
    resultElement.textContent = 'It\'s a tie!';
  }
}

function evaluateHand(hand) {
  let rankCounts = {};
  for (let card of hand) {
    rankCounts[card.rank] = (rankCounts[card.rank] || 0) + 1;
  }

  let maxCount = 0;
  for (let rank in rankCounts) {
    maxCount = Math.max(maxCount, rankCounts[rank]);
  }

  return maxCount;
}
</script>
</body></html>
``` [end of text]


