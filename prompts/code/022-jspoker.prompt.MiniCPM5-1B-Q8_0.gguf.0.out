<!DOCTYPE html>
<html>
<head>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
function playPoker() {
  const deck = [...Array(52).keys()].map(i => ({suit: i % 4, value: i / 4}));
  const shuffled = deck.sort(() => Math.random() - 0.5);
  const playerHand = shuffled.slice(0, 5).map(deck => deck.map(d => ({name: d.suit, value: d.value})));
  const dealerHand = shuffled.slice(5).map(deck => deck.map(d => ({name: d.suit, value: d.value})));
  const playerHandHand = playerHand.map(hand => [...hand.slice(0, 2)].map(h => ({name: h.suit, value: h.value})));
  const dealerHandHand = dealerHand.map(hand => [...hand.slice(0, 2)].map(h => ({name: h.suit, value: h.value})));
  const playerHandScore = calculateScore(playerHandHand);
  const dealerHandScore = calculateScore(dealerHandHand);
  const result = determineResult(playerHandScore, dealerHandScore);
  alert(result);
}

function calculateScore(hand) {
  let score = 0;
  for (let i = 0; i < 5; i++) {
    if (hand[i].name === 'A') {
      score += 10;
    } else if (hand[i].name === 'K') {
      score += 10;
    } else if (hand[i].name === 'Q') {
      score += 10;
    } else if (hand[i].name === 'J') {
      score += 10;
    } else if (hand[i].name === 'T') {
      score += 10;
    } else if (hand[i].name === 'H') {
      score += 10;
    } else if (hand[i].name === 'S') {
      score += 10;
    } else if (hand[i].name === 'C') {
      score += 10;
    } else if (hand[i].name === 'D') {
      score += 10;
    } else if (hand[i].name === 'O') {
      score += 10;
    } else if (hand[i].name === 'K') {
      score += 10;
    } else if (hand[i].name === 'Q') {
      score += 10;
    } else if (hand[i].name === 'J') {
      score += 10;
    } else if (hand[i].name === 'T') {
      score += 10;
    } else if (hand[i].name === 'H') {
      score += 10;
    } else if (hand[i].name === 'S') {
      score += 10;
    } else if (hand[i].name === 'C') {
      score += 10;
    } else if (hand[i].name === 'D') {
      score += 10;
    } else if (hand[i].name === 'O') {
      score += 10;
    }
  }
  return score;
}

function determineResult(playerScore, dealerScore) {
  if (playerScore > dealerScore) {
    return 'Player wins!';
  } else if (playerScore < dealerScore) {
    return 'Dealer wins!';
  } else {
    return 'Push!';
  }
}

function shuffleArray(array) {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
}

function playPoker() {
  const deck = [...Array(52).keys()].map(i => ({suit: i % 4, value: i / 4}));
  const shuffled = deck.sort(() => Math.random() - 0.5);
  const playerHand = shuffled.slice(0, 5).map(deck => deck.map(d => ({name: d.suit, value: d.value})));
  const dealerHand = shuffled.slice(5).map(deck => deck.map(d => ({name: d.suit, value: d.value})));
  const playerHandHand = playerHand.map(hand => [...hand.slice(0, 2)].map(h => ({name: h.suit, value: h.value})));
  const dealerHandHand = dealerHand.map(hand => [...hand.slice(0, 2)].map(h => ({name: h.suit, value: h.value})));
  const playerHandScore = calculateScore(playerHandHand);
  const dealerHandScore = calculateScore(dealerHandHand);
  const result = determineResult(playerHandScore, dealerHandScore);
  alert(result);
}

playPoker();
</script>
</head>
</body>
