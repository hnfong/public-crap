```java
import java.util.Scanner;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        StringBuilder input = new StringBuilder();
        while (scanner.hasNextLine()) {
            input.append(scanner.nextLine()).append("\n");
        }
        scanner.close();

        String text = input.toString();
        Pattern pattern = Pattern.compile("(\\d{1,3}(?:,\\d{3})+|\\d+)([kKmMgG]?)");
        Matcher matcher = pattern.matcher(text);

        double total = 0.0;
        while (matcher.find()) {
            String numStr = matcher.group(1).replace(",", "");
            String suffix = matcher.group(2).toLowerCase();
            double value = Double.parseDouble(numStr);
            switch (suffix) {
                case "k": value *= 1024.0; break;
                case "m": value *= 1024.0 * 1024.0; break;
                case "g": value *= 1024.0 * 1024.0 * 1024.0; break;
                default: break;
            }
            total += value;
        }

        System.out.printf("%.1f%n", total);
        System.out.printf("%.1f k%n", total / 1024.0);
        System.out.printf("%.1f M%n", total / (1024.0 * 1024.0));
        System.out.printf("%.1f G%n", total / (1024.0 * 1024.0 * 1024.0));
    }
}
