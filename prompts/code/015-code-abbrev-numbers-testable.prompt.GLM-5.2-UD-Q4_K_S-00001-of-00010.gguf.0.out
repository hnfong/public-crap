```python
def abbrev_num(x):
    if x < 0:
        return "-" + abbrev_num(-x)
    
    if x < 1000:
        return str(x)
    
    suffixes = ['', 'K', 'M', 'B', 'T']
    magnitude = 0
    while x >= 1000 and magnitude < len(suffixes) - 1:
        x /= 1000.0
        magnitude += 1
        
    suffix = suffixes[magnitude]
    
    # Round to 1 decimal place
    rounded = round(x, 1)
    
    # If rounding up pushes it to the next magnitude (e.g., 999.9K -> 1000K)
    if rounded >= 1000 and magnitude < len(suffixes) - 1:
        rounded /= 1000.0
        rounded = round(rounded, 1)
        magnitude += 1
        suffix = suffixes[magnitude]
        
    # Format the number, dropping the decimal if it's an integer
    if rounded == int(rounded):
        s = str(int(rounded))
    else:
        s = str(rounded)
        
    res = s + suffix
    
    # Enforce the 4-character limit by dropping the decimal if necessary
    if len(res) > 4:
        if rounded == int(rounded):
            s = str(int(rounded))
        else:
            s = str(int(round(rounded)))
        res = s + suffix
        
    return res
``` [end of text]


