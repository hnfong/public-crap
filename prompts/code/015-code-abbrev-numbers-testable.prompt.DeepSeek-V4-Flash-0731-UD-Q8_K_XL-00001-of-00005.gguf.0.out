```python
def abbrev_num(x):
    if x < 1000:
        return str(x)
    units = ['', 'K', 'M', 'B', 'T']
    unit_index = 0
    temp = float(x)
    while temp >= 1000 and unit_index < len(units) - 1:
        temp /= 1000
        unit_index += 1
    if temp >= 100:
        return f"{int(round(temp))}{units[unit_index]}"
    elif temp >= 10:
        return f"{int(round(temp))}{units[unit_index]}"
    else:
        return f"{temp:.1f}{units[unit_index]}"
