```python
def abbrev_num(x):
    if x < 1000:
        return str(x)
    elif x < 1_000_000:
        val = x / 1000
        if val < 100:
            return f"{round(val)}K"
        else:
            return f"{round(val / 10)}K"
    elif x < 1_000_000_000:
        val = x / 1_000_000
        if val < 100:
            return f"{round(val)}M"
        else:
            return f"{round(val / 10)}M"
    else:
        val = x / 1_000_000_000
        if val < 100:
            return f"{round(val)}B"
        else:
            return f"{round(val / 10)}B"
