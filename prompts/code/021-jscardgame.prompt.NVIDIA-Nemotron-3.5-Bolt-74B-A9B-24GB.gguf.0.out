<!DOCTYPE html><html><head><title>Stack Solitaire</title><style>body{margin:0;background:#222;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;overflow:hidden;}canvas{background:#444;border:2px solid #666;box-shadow:0 0 20px rgba(0,0,0,0.5);}#msg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;background:rgba(0,0,0,0.8);padding:20px;border-radius:8px;display:none;}button{padding:10px 20px;font-size:16px;cursor:pointer;}</style></head><body><canvas id="c"></canvas><div id="msg"><h1>GAME OVER</h1><p id="score">Score: 0</p><button onclick="reset()">Play Again</button></div><script>const c=document.getElementById('c'),ctx=c.getContext('2d');let W,H,cols=[],selected=null,score=0,gameOver=false;const SUITS=['♠','♥','♦','♣'];function init(){W=c.width=400;H=c.height=600;cols=[];for(let i=0;i<7;i++){cols.push([]);for(let j=0;j<5;j++)cols[i].push({suit:SUITS[j%4],rank:j+1,faceUp:j===4,x:50+i*50,y:50+j*30,w:40,h:30});}selected=null;score=0;gameOver=false;loop();}function loop(){ctx.clearRect(0,0,W,H);cols.forEach((col,i)=>{col.forEach(card=>{ctx.fillStyle=card.faceUp?'#fff':'#666';ctx.fillRect(card.x,card.y,card.w,card.h);ctx.strokeStyle='#000';ctx.strokeRect(card.x,card.y,card.w,card.h);if(card.faceUp){ctx.fillStyle='#000';ctx.font='20px sans-serif';ctx.fillText(card.rank+card.suit,card.x+5,card.y+25);}});});if(selected){ctx.fillStyle='rgba(255,255,0,0.3)';ctx.fillRect(selected.x,selected.y,selected.w,selected.h);}if(gameOver){document.getElementById('msg').style.display='block';document.getElementById('score').innerText='Score: '+score;}requestAnimationFrame(loop);}function moveCard(fromCol,toCol,cardIdx){const card=cols[fromCol][cardIdx];if(!card.faceUp)return;const target=cols[toCol][cols[toCol].length-1];if(!target||(card.rank===target.rank+1&&card.suit!==target.suit)){cols[toCol].push(card);cols[fromCol].splice(cardIdx,1);if(cols[fromCol].length>0)cols[fromCol][cols[fromCol].length-1].faceUp=true;score++;checkWin();}}function checkWin(){if(cols.every(c=>c.length===0)){gameOver=true;}}c.addEventListener('mousedown',e=>{if(gameOver)return;const rect=e.getBoundingClientRect();const x=e.clientX-rect.left,y=e.clientY-rect.top;cols.forEach((col,i)=>{col.forEach((card,j)=>{if(x>=card.x&&x<=card.x+card.w&&y>=card.y&&y<=card.y+card.h){selected=card;}});});});c.addEventListener('mouseup',e=>{if(!selected||gameOver)return;const rect=e.getBoundingClientRect();const x=e.clientX-rect.left,y=e.clientY-rect.top;cols.forEach((col,i)=>{if(x>=50+i*50&&x<=50+i*50+40&&y>=50&&y<=550){const last=cols[i][cols[i].length-1];if(last&&selected.rank===last.rank+1&&selected.suit!==last.suit){moveCard(cols.indexOf(cols.find(c=>c.includes(selected))),i,cols.find(c=>c.includes(selected)).indexOf(selected));}else if(!last&&selected.rank===13){moveCard(cols.indexOf(cols.find(c=>c.includes(selected))),i,cols.find(c=>c.includes(selected)).indexOf(selected));}}});selected=null;});reset();</script></body></html> [end of text]


