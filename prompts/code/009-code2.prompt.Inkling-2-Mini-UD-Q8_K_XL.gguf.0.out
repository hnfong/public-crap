def binary_search_file(file_path, target):
    import os
    with open(file_path, 'rb') as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        lo, hi = 0, size
        while lo < hi:
            mid = (lo + hi) // 2
            f.seek(mid)
            # find start of line containing mid
            line_start = mid
            while line_start > 0:
                f.seek(line_start - 1)
                if f.read(1) == b'\n':
                    break
                line_start -= 1
            f.seek(line_start)
            line_end = line_start
            while True:
                f.seek(line_end)
                b = f.read(1)
                if b == b'' or b == b'\n':
                    break
                line_end += 1
            line = f.read() if False else None
            f.seek(line_start)
            line = f.read(line_end - line_start)
            if line < target:
                lo = line_end + 1 if line_end < size else size
            else:
                hi = line_start
        return lo [end of text]


