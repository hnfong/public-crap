<|start|>assistant to=user<|message|>```java
import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.text.DecimalFormat;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class Main {
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder sb = new StringBuilder();
        String line;
        while ((line = br.readLine()) != null) {
            sb.append(line).append(' ');
        }
        String text = sb.toString();

        Pattern p = Pattern.compile("([0-9][0-9,]*\\.?[0-9]*)\\s*([kKmMgG])?");
        Matcher m = p.matcher(text);

        double totalBytes = 0.0;
        while (m.find()) {
            String numStr = m.group(1).replace(",", "");
            String suf = m.group(2);
            double value;
            try {
                value = Double.parseDouble(numStr);
            } catch (NumberFormatException e) {
                continue;
            }
            long mult = 1;
            if (suf != null) {
                char c = Character.toLowerCase(suf.charAt(0));
                if (c == 'k') mult = 1024L;
                else if (c == 'm') mult = 1024L * 1024L;
                else if (c == 'g') mult = 1024L * 1024L * 1024L;
            }
            totalBytes += value * mult;
        }

        DecimalFormat df = new DecimalFormat("#.##########");
        df.setDecimalSeparatorAlwaysShown(false);
        System.out.println(df.format(totalBytes));

        double k = totalBytes / 1024.0;
        double m = totalBytes / (1024.0 * 1024.0);
        double g = totalBytes / (1024.0 * 1024.0 * 1024.0);

        System.out.printf("%.1f k%n", k);
        System.out.printf("%.1f M%n", m);
        System.out.printf("%.1f G%n", g);
    }
}
