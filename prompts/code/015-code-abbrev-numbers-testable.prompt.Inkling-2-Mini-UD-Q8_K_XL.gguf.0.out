def abbrev_num(x):
    if abs(x) < 1000:
        return str(x)
    units = [(1_000_000_000, 'B'), (1_000_000, 'M'), (1_000, 'K')]
    for divisor, suffix in units:
        if abs(x) >= divisor:
            value = x / divisor
            if abs(value) >= 100:
                rounded = round(value)
                return f"{rounded}{suffix}"
            elif abs(value) >= 10:
                rounded = round(value * 10) / 10
                s = f"{rounded:.1f}".rstrip('0').rstrip('.')
                return f"{s}{suffix}"
            else:
                rounded = round(value * 10) / 10
                s = f"{rounded:.1f}".rstrip('0').rstrip('.')
                return f"{s}{suffix}"
    return str(x) [end of text]


