<!DOCTYPE html><html>
<head><meta charset="utf-8"><title>Memory Match</title>
<style>
body{font-family:sans-serif;background:#222;color:#fff;display:flex;flex-direction:column;align-items:center;padding:20px}
h1{margin:10px}
#grid{display:grid;grid-template-columns:repeat(4,80px);gap:10px;margin-top:20px}
.card{width:80px;height:100px;background:#444;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:40px;cursor:pointer;transition:transform .3s;user-select:none}
.card.flipped{background:#666;transform:rotateY(180deg)}
.card.matched{background:#2a7;pointer-events:none}
#stats{margin:10px;font-size:18px}
button{margin-top:15px;padding:10px 20px;font-size:16px;cursor:pointer;background:#444;color:#fff;border:none;border-radius:5px}
</style>
</head>
<body>
<h1>Memory Match</h1>
<div id="stats">Moves: 0 | Matches: 0/8</div>
<div id="grid"></div>
<button onclick="init()">New Game</button>
<script>
let cards=[],flipped=[],moves=0,matches=0;
const symbols=['🍎','🍌','🍇','🍓','🍒','🍑','🍍','🥝'];
function init(){
cards=[...symbols,...symbols].sort(()=>Math.random()-.5);
flipped=[];moves=0;matches=0;
document.getElementById('stats').textContent='Moves: 0 | Matches: 0/8';
const grid=document.getElementById('grid');
grid.innerHTML='';
cards.forEach((s,i)=>{
const d=document.createElement('div');
d.className='card';d.dataset.i=i;d.textContent='?';
d.onclick=()=>flip(d,i);
grid.appendChild(d);
});
}
function flip(el,i){
if(flipped.length>=2||el.classList.contains('flipped')||el.classList.contains('matched'))return;
el.classList.add('flipped');el.textContent=cards[i];
flipped.push({el,i});
if(flipped.length===2){
moves++;
document.getElementById('stats').textContent=`Moves: ${moves} | Matches: ${matches}/8`;
const[a,b]=flipped;
if(cards[a.i]===cards[b.i]){
a.el.classList.add('matched');b.el.classList.add('matched');
matches++;
document.getElementById('stats').textContent=`Moves: ${moves} | Matches: ${matches}/8`;
if(matches===8)setTimeout(()=>alert(`You won in ${moves} moves!`),300);
}
else setTimeout(()=>{
a.el.classList.remove('flipped');a.el.textContent='?';
b.el.classList.remove('flipped');b.el.textContent='?';
flipped=[];
},800);
flipped=[];
}
}
init();
</script>
</body>
</html> [end of text]


