```java
import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class NumberConverter {

    private static final Pattern NUMBER_PATTERN = Pattern.compile("\\d+(\\.\\d+)?[KMGG]");
    private static final Pattern Suffix_PATTERN = Pattern.compile("[KMGG]");

    public static void main(String[] args) {
        try (BufferedReader br = new BufferedReader(new InputStreamReader(System.in))) {
            String line;
            int totalKilo = 0;
            int totalMega = 0;
            int totalGig = 0;

            while ((line = br.readLine()) != null) {
                line = line.trim();
                if (line.isEmpty()) continue;

                Matcher matcher = Suffix_PATTERN.matcher(line);
                while (matcher.find()) {
                    String suffix = matcher.group();
                    String numberStr = line.substring(matcher.start(), matcher.end());
                    String number = numberStr.replaceAll("\\s+", "");
                    if (number.isEmpty()) continue;

                    int value = Integer.parseInt(number);
                    if (suffix.equals("K")) {
                        totalKilo += value;
                    } else if (suffix.equals("M")) {
                        totalMega += value;
                    } else if (suffix.equals("G")) {
                        totalGig += value;
                    }
                }
            }

            double totalKiloValue = totalKilo / 1024.0;
            double totalMegaValue = totalMega / 1024.0 * 1024.0;
            double totalGigValue = totalGig / 1024.0 * 1024.0 * 1024.0;

            System.out.printf("%.1f\n", totalKiloValue);
            System.out.printf("%.1f k\n", totalKiloValue * 1024.0);
            System.out.printf("%.1f M\n", totalMegaValue);
            System.out.printf("%.1f M\n", totalMegaValue * 1024.0);
            System.out.printf("%.1f G\n", totalGigValue);
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
