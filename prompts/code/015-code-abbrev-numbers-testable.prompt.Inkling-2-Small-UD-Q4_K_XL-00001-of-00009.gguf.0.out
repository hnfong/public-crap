```python
def abbrev_num(x):
    if x == 0:
        return "0"
    sign = "-" if x < 0 else ""
    n = abs(x)
    units = [(1e9, "B"), (1e6, "M"), (1e3, "K")]
    for threshold, suffix in units:
        if n >= threshold:
            value = n / threshold
            if value >= 100:
                return f"{sign}{int(round(value))}{suffix}"
            rounded = round(value, 1)
            if rounded >= 100:
                return f"{sign}100{suffix}"
            if rounded == int(rounded):
                return f"{sign}{int(rounded)}{suffix}"
            return f"{sign}{rounded:.1f}{suffix}"
    return f"{sign}{int(n)}"
``` [end of text]


