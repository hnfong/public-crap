Output first line <!DOCTYPE html><html>

Provide full HTML.

Let's produce compact code.<|start|>assistant to=user<|message|><!DOCTYPE html><html><head><meta charset="utf-8"><title>Poker</title><style>body{font-family:sans-serif;background:#0a3d0a;color:#fff;margin:0;padding:10px} #t{display:flex;gap:8px;margin:10px 0}.c{width:60px;height:84px;background:#fff;color:#000;border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:bold;border:2px solid #000;cursor:pointer} .c.sel{border-color:#ff0} #log{white-space:pre-wrap;margin-top:10px}</style></head><body><h2>5 Card Draw vs Dealer</h2><div>Credits: <span id="cr">100</span> Bet: <input id="bet" type="number" value="10" style="width:60px"> <button id="deal">Deal</button></div><div id="t"></div><div><button id="draw">Draw</button><button id="stand">Stand</button></div><div id="log"></div><script>const suits=['♠','♥','♦','♣'],ranks=['2','3','4','5','6','7','8','9','T','J','Q','K','A'];let deck=[],player=[],dealer=[],credits=100,bet=10,phase=0;const t=document.getElementById('t'),log=document.getElementById('log'),cr=document.getElementById('cr');function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}}function newDeck(){deck=[];for(let s=0;s<4;s++)for(let r=0;r<13;r++)deck.push(r+':'+s)}function cardToStr(c){const [v,s]=c.split(':');return ranks[v]+suits[s]}function rankHand(cards){const vals=cards.map(c=>+c.split(':')[0]).sort((a,b)=>a-b);const suitsArr=cards.map(c=>+c.split(':')[1]);const counts={};vals.forEach(v=>counts[v]=(counts[v]||0)+1);const cnts=Object.values(counts).sort((a,b)=>b-a);const isFlush=suitsArr.every(s=>s===suitsArr[0]);const isStraight=vals[4]-vals[0]===4&&new Set(vals).size===5||vals.join(',')==='0,1,2,3,12';let score=0;if(isStraight&&isFlush)score=8;else if(cnts[0]===4)score=7;else if(cnts[0]===3&&cnts[1]===2)score=6;else if(isFlush)score=5;else if(isStraight)score=4;else if(cnts[0]===3)score=3;else if(cnts[1]===2&&cnts[2]===2)score=2;else if(cnts[0]===2)score=1;else score=0;return score*100+vals[4]}function render(){t.innerHTML='';[...player,...dealer].forEach((c,i)=>{const d=document.createElement('div');d.className='c'+(player.includes(c)&&phase===1&&document.querySelectorAll('.c.sel').length? '': '');if(i<5){d.textContent=cardToStr(c);if(phase===1){d.onclick=()=>{d.classList.toggle('sel')}}}else{d.textContent='?'}t.appendChild(d)})}document.getElementById('deal').onclick=()=>{bet=+document.getElementById('bet').value;if(bet>credits||bet<=0)return;credits-=bet;cr.textContent=credits;newDeck();shuffle(deck);player=deck.splice(0,5);dealer=deck.splice(0,5);phase=1;log.textContent='Your turn. Select cards to discard then Draw.';render()}document.getElementById('draw').onclick=()=>{if(phase!==1)return;const sel=[...document.querySelectorAll('.c.sel')];const idxs=[];[...player].forEach((c,i)=>{const el=t.children[i];if(el.classList.contains('sel'))idxs.push(i)});idxs.forEach(i=>{player[i]=deck.pop()});phase=2;log.textContent='Dealer draws...';setTimeout(()=>{const dRank=rankHand(dealer);const pRank=rankHand(player);let res='';if(pRank>dRank){credits+=bet*2;res='You win!';}else if(pRank<dRank){res='Dealer wins.';}else{credits+=bet;res='Push.';}cr.textContent=credits;log.textContent+=`\nYou: ${pRank} Dealer: ${dRank}\n${res}`;phase=0;render()},500)}document.getElementById('stand').onclick=()=>{if(phase!==1)return;phase=2;log.textContent='Standing...';setTimeout(()=>{const dRank=rankHand(dealer);const pRank=rankHand(player);let res='';if(pRank>dRank){credits+=bet*2;res='You win!';}else if(pRank<dRank){res='Dealer wins.';}else{credits+=bet;res='Push.';}cr.textContent=credits;log.textContent+=`\nYou: ${pRank} Dealer: ${dRank}\n${res}`;phase=0;render()},500)}</script></body></html> [end of text]


